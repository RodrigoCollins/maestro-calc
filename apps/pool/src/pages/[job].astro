---
import type { GetStaticPaths } from 'astro';
import Byline from '../components/Byline.astro';
import Layout from '../components/Layout.astro';
import JobLinks from '../components/JobLinks.astro';
import Sources from '../components/Sources.astro';
import { jobDetailOf } from '../job-detail.ts';
import { JOB_PAGES, type JobPage } from '../jobs.ts';
import { jobTrailOf } from '../seo/breadcrumb.ts';
import { VOLUME_CHART } from '../volume/chart.ts';

// One page per common job, its figures worked out by the engines at build time (no script).
export const getStaticPaths = (() =>
  JOB_PAGES.map((page) => ({
    params: { job: page.path.slice(1) },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: JobPage };
const trail = jobTrailOf(page);
const here = trail.at(-1);
const detail = jobDetailOf(page);
---

<Layout title={page.title} description={page.description} {trail} modified={page.checked}>
  <main class="pool-page">
    <nav aria-label="Breadcrumb">
      <ol class="pool-crumbs">
        {trail.slice(0, -1).map(({ name, path }) => (
          <li>
            <a href={path}>{name}</a>
          </li>
        ))}
        <li aria-current="page">{here?.name}</li>
      </ol>
    </nav>
    <h1>{page.h1}</h1>
    <Byline path={page.path} />
    <p>{page.lead}</p>
    <figure class="pool-job-figure">
      <p class="pool-marker">
        {page.figure.value}
        <small>{page.figure.unit}</small>
      </p>
      <figcaption>{page.figure.caption}</figcaption>
    </figure>
    <table class="pool-job-table">
      <thead>
        <tr>
          {page.head.map((cell) => (
            <th scope="col">{cell}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {page.rows.map(({ cells: [label, ...figures] }) => (
          <tr>
            <th scope="row">{label}</th>
            {figures.map((cell) => (
              <td>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      <a href={page.calculator.href}>{page.calculator.label}</a>
    </p>
    {page.calculator.path === VOLUME_CHART.calculator.href && (
      <p>
        <a href={VOLUME_CHART.path}>Every common size in the pool volume chart</a>
      </p>
    )}
    {page.guide !== undefined && (
      <p>
        <a href={page.guide.href}>{page.guide.label}</a>
      </p>
    )}
    <p class="pool-job-method">{page.method}</p>
    <section class="pool-job-detail" aria-labelledby="worked-heading">
      <h2 id="worked-heading">How the figures are worked out</h2>
      <ol>
        {detail.worked.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>
    {detail.tables.map((table, index) => (
      <section class="pool-job-detail" aria-labelledby={`table-heading-${String(index + 1)}`}>
        <h2 id={`table-heading-${String(index + 1)}`}>{table.heading}</h2>
        <table class="pool-job-table">
          <caption>{table.caption}</caption>
          <thead>
            <tr>
              {table.head.map((cell) => (
                <th scope="col">{cell}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {table.rows.map(([label, ...cells]) => (
              <tr>
                <th scope="row">{label}</th>
                {cells.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
    {detail.label !== undefined && (
      <section class="pool-job-detail" aria-labelledby="label-heading">
        <h2 id="label-heading">{detail.label.heading}</h2>
        <ul>
          {detail.label.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}
    <section class="pool-job-detail" aria-labelledby="next-heading">
      <h2 id="next-heading">{detail.next.heading}</h2>
      <ul>
        {detail.next.items.map(({ text, link }) => (
          <li>
            {text}
            {link !== undefined && (
              <>
                {' '}
                <a href={link.href}>{link.label}</a>
              </>
            )}
          </li>
        ))}
      </ul>
    </section>
    <Sources path={page.path} />
    <JobLinks page={page} />
  </main>
</Layout>

<style>
  .pool-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .pool-crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
  }

  .pool-job-figure {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .pool-job-table {
    border-collapse: collapse;
    background: #ffffff;
    font-variant-numeric: tabular-nums;
  }

  .pool-job-table th,
  .pool-job-table td {
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--ink);
    text-align: right;
  }

  .pool-job-table th[scope='row'] {
    text-align: left;
  }

  .pool-job-table caption {
    padding-bottom: 0.5rem;
    text-align: left;
    line-height: 1.5;
  }

  .pool-job-method {
    font-size: 0.9375rem;
  }

  .pool-job-detail h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
  }

  .pool-job-detail ol,
  .pool-job-detail ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.5;
  }

  /* Each link stands at least 24 px tall with its padding (WCAG 2.5.8, target size). */
  .pool-job-detail a {
    display: inline-block;
    padding-block: 0.25rem;
  }
</style>
