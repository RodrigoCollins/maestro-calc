---
import type { Locale } from '@maestro-calc/i18n';
import { getEntry, render } from 'astro:content';
import CalculatorBody from '../components/calculator/CalculatorBody.astro';
import GuideLinks from '../components/GuideLinks.astro';
import JobLinks from '../components/JobLinks.astro';
import type { CalculatorContent } from '../components/calculator/model.ts';
import { faqOf } from '../content/faq.ts';
import { headingOf } from '../content/heading.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { calendarDay } from '../lib/calendar-day.ts';
import { jobLinks } from '../lib/job-links.ts';
import { PAGES, headStyleOf, pageView } from '../lib/pages.ts';
import { siteText } from '../lib/site-text.ts';
import { guidesOf } from '../routing/guides.ts';
import { hubOfCalculator } from '../routing/hubs.ts';
import { pathOf } from '../routing/routes.ts';
import type { CalculatorPageId } from '../routing/templates.ts';
import { calculatorJsonLd, serializeJsonLd } from '../seo/json-ld.ts';
import { headFor } from '../seo/head.ts';
import { SCRIPTS } from './scripts.ts';

interface Props {
  id: CalculatorPageId;
  locale: Locale;
}

const { id, locale } = Astro.props;
const text = siteText(locale);
const entry = await getEntry('calculators', `${locale}/${id}`);
if (entry === undefined) throw new Error(`no calculator entry for ${locale}/${id}`);
const { Content } = await render(entry);
const view = pageView(id, locale);
const day = (iso: string): string => calendarDay(iso, locale);
const { updated, sources } = entry.data;
const content: CalculatorContent = {
  updatedLabel: text('site.trust.updated'),
  updated,
  updatedText: day(updated),
  sources: sources.map(({ name, url, retrieved }) => ({ name, url, retrieved: day(retrieved) })),
};
const jsonLd = serializeJsonLd(
  calculatorJsonLd({ id, name: view.title }, locale, faqOf(entry.body ?? '')),
);
const guides = await Promise.all(
  guidesOf(id).map(async (guide) => {
    const page = await getEntry('pages', `${locale}/${guide}`);
    if (page === undefined) throw new Error(`no content entry for ${locale}/${guide}`);
    return { href: pathOf(guide, locale), title: headingOf(page.body ?? '') };
  }),
);
// the job pages of this calculator (growth plan, lever 1), each linked back from here
const jobs = jobLinks(id, locale);
const hubId = hubOfCalculator(id);
// the trade hub (hubs › [HB3]), named by its page title without the site name
const hub =
  hubId === undefined
    ? undefined
    : {
        href: pathOf(hubId, locale),
        name: text(`page.${hubId}.title`).replace(/ \| Maestro Calc$/, ''),
      };
const Script = SCRIPTS[id];
const style = headStyleOf(PAGES[id]);
---

<BaseLayout {locale} {id} head={{ ...headFor(id, locale, text), jsonLd }} {style}>
  <CalculatorBody {view} {content}>
    <div class="prose">
      <Content />
    </div>
    {guides.length > 0 && <GuideLinks label={text('site.guide.links')} {guides} />}
    {jobs.length > 0 && <JobLinks label={text('site.hub.jobs')} {jobs} />}
    {hub !== undefined && (
      <p class="hub-link">
        {text('site.hub.more')} <a href={hub.href}>{hub.name}</a>
      </p>
    )}
  </CalculatorBody>
  <Script />
</BaseLayout>
