---
import { helpId, hintId, inputId } from '../../calculator/concrete-layout.ts';
import type { Field } from './model.ts';

interface Props {
  field: Field;
  hidden?: boolean;
}
const { field, hidden = false } = Astro.props;
const id = inputId(field.key);
const { hint, help } = field;
// The input is described by its unit hint and its help text; a message for an error uses the same
// attribute, so the script swaps it in (calculator-page › Errors without a button).
const describedBy = [
  hint === undefined ? '' : hintId(field.key),
  help === undefined ? '' : helpId(field.key),
]
  .filter((part) => part !== '')
  .join(' ');
---

<div class="calc-field" hidden={hidden}>
  <label for={id}>{field.label}</label>
  <input
    id={id}
    name={field.key}
    inputmode={field.mode}
    autocomplete="off"
    value={field.value}
    placeholder={field.placeholder}
    aria-describedby={describedBy === '' ? undefined : describedBy}
    disabled
  />
  {hint !== undefined && <small id={hintId(field.key)}>{hint}</small>}
  {help !== undefined && (
    <p class="calc-help" id={helpId(field.key)}>
      {help}
    </p>
  )}
</div>
