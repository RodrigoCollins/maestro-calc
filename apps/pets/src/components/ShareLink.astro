---
import { canonicalUrl } from '@maestro-calc/site-kit/canonical';
import { langOf } from '../routes.ts';
import { nameOf } from '../seo/json-ld.ts';
import { shareMessage, whatsappHref } from '../share/href.ts';
import { SITE } from '../site.config.ts';

/** The WhatsApp share link of a page: plain words and its address, no script of WhatsApp's. */
interface Props {
  readonly path: string;
  readonly title: string;
}

const { path, title } = Astro.props;
const en = langOf(path) === 'en';
const text = en ? `${nameOf(title)}, on ${SITE.name}:` : `${nameOf(title)}, auf ${SITE.name}:`;
const label = en ? 'Share on WhatsApp' : 'Per WhatsApp teilen';
---

<a
  class="bf-share"
  data-share={text}
  href={whatsappHref(shareMessage(text, canonicalUrl(path, SITE.origin)))}
  aria-label={`${label}: ${nameOf(title)}`}
>
  {label}
</a>
