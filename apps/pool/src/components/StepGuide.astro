---
import Byline from './Byline.astro';
import JobLinks from './JobLinks.astro';
import Layout from './Layout.astro';
import Sources from './Sources.astro';
import type { GuideSource, GuideStep, GuideTable } from '../guide.ts';
import { langOf } from '../routes.ts';

/** A guide of numbered steps, each tile with its calculator link and its sources (`guide.ts`). */
interface Props {
  readonly guide: {
    readonly path: string;
    /** The day its figures were last checked (`YYYY-MM-DD`), for its byline and its JSON-LD. */
    readonly checked: string;
    readonly kicker: string;
    readonly title: string;
    readonly description: string;
    readonly h1: string;
    readonly lead: string;
    readonly note?: string;
    readonly table?: GuideTable;
    readonly sources: Readonly<Record<string, GuideSource>>;
    readonly steps: readonly GuideStep[];
  };
}

const { path, checked, kicker, title, description, h1, lead, note, table, steps, sources } =
  Astro.props.guide;
const lang = langOf(path);
/** The copy the guide writes around its steps, in its language. */
const TEXTS = {
  en: {
    note: 'Read the label of each product before you add it, and follow it where it differs from this guide.',
    source: 'Source:',
  },
  es: {
    note: 'Lee la etiqueta de cada producto antes de agregarlo, y síguela donde sea distinta de esta guía.',
    source: 'Fuente:',
  },
} as const;
const text = TEXTS[lang];
const sourceOf = (key: string): GuideSource => {
  const source = sources[key];
  if (source === undefined) throw new Error(`no source ${key}`);
  return source;
};
---

<Layout {title} {description} modified={checked}>
  <main class="pool-page">
    <p class="pool-kicker">{kicker}</p>
    <h1>{h1}</h1>
    <Byline {path} />
    <p>{lead}</p>
    {table !== undefined && (
      <>
        <div class="pool-scroll" role="region" aria-label={table.region} tabindex="0">
          <table class="pool-table">
            <caption>{table.caption}</caption>
            <thead>
              <tr>
                {table.head.map((cell) => (
                  <th scope="col">{cell}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {table.rows.map(([first, ...rest]) => (
                <tr>
                  <th scope="row">{first}</th>
                  {rest.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="pool-step-source">
          {text.source}{' '}
          {table.sources.map((key, index) => (
            <>
              {index > 0 && ', '}
              <a href={sourceOf(key).url}>{sourceOf(key).name}</a>
            </>
          ))}
        </p>
      </>
    )}
    <ol class="pool-steps">
      {steps.map((step) => (
        <li>
          <h2>{step.title}</h2>
          <p>{step.text}</p>
          {step.link !== undefined && (
            <p>
              <a href={step.link.href}>{step.link.label}</a>
            </p>
          )}
          {step.sources !== undefined && (
            <p class="pool-step-source">
              {text.source}{' '}
              {step.sources.map((key, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={sourceOf(key).url}>{sourceOf(key).name}</a>
                </>
              ))}
            </p>
          )}
        </li>
      ))}
    </ol>
    <Sources {path} />
    <p class="pool-note">{note ?? text.note}</p>
    {/* the job pages are English for now: the Spanish guide leaves their links out */}
    {lang === 'en' && <JobLinks guide={path} />}
  </main>
</Layout>

<style>
  /* a narrow phone scrolls the table, never the page */
  .pool-scroll {
    max-width: 100%;
    overflow-x: auto;
  }

  .pool-table {
    width: 100%;
    border-collapse: collapse;
    border: 3px solid var(--ink);
    background: #ffffff;
    line-height: 1.35;
  }

  .pool-table caption {
    padding-bottom: 0.5rem;
    text-align: left;
    font-weight: 600;
  }

  .pool-table th,
  .pool-table td {
    padding: 0.625rem 0.5rem;
    border-top: 1px solid var(--joint);
    text-align: left;
    vertical-align: top;
  }

  .pool-table thead th {
    border-top: 0;
    border-bottom: 3px solid var(--ink);
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
  }

  .pool-steps {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  /* Each step is a tile numbered like a depth marker. */
  .pool-steps li {
    counter-increment: step;
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 3px solid var(--ink);
    background: #ffffff;
  }

  .pool-steps h2 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
    text-transform: uppercase;
    line-height: 1;
  }

  .pool-steps h2::before {
    content: counter(step) '. ';
  }

  .pool-steps p {
    margin: 0;
    line-height: 1.5;
  }

  .pool-step-source {
    font-size: 0.875rem;
  }
</style>
