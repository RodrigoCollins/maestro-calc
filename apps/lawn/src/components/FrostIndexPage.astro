---
import { FROST_CHECKED } from '../editorial.ts';
import { frostPathOf, FROST_PAGES, FROST_STATES } from '../frost.ts';
import { CITY_GUIDES } from '../city-guides.ts';
import { FROST_FOOTNOTE, FROST_TEXT } from '../frost-copy.ts';
import { frostIndexSummary } from '../frost-summary.ts';
import { pageTrailOf } from '../seo/breadcrumb.ts';
import Byline from './Byline.astro';
import Layout from './Layout.astro';
import ShareLink from './ShareLink.astro';
import Sources from './Sources.astro';
import ZipLookup from './ZipLookup.astro';

const { index } = FROST_TEXT;
const summary = frostIndexSummary();
const path = '/frost-dates';
const partsOf = (slug: string) => FROST_PAGES.filter(({ state }) => state.slug === slug).length;
---

<Layout
  title={index.title}
  description={index.description}
  trail={pageTrailOf({ path, title: index.title })}
  modified={FROST_CHECKED}
>
  <Fragment slot="hero">
    <section class="lawn-hero tall">
      <h1>{index.h1}</h1>
      <Byline {path} />
      <p>{index.lead}</p>
    </section>
  </Fragment>
  <main class="lawn-main lifted">
    <ZipLookup />
    <section class="lawn-section" aria-labelledby="states">
      <h2 id="states">{index.statesHeading}</h2>
      <ul class="lawn-states">
        {FROST_STATES.map(({ slug, name }) => (
          <li>
            <a href={frostPathOf(slug)}>{name}</a>
            {partsOf(slug) > 1 && <span> ({partsOf(slug)} pages)</span>}
          </li>
        ))}
      </ul>
    </section>
    <section class="lawn-section" aria-labelledby="cities">
      <h2 id="cities">{index.citiesHeading}</h2>
      <p>{index.citiesLead}</p>
      <ul class="lawn-cities">
        {CITY_GUIDES.map(({ path: href, card }) => (
          <li>
            <a {href}>{card.title}</a>
          </li>
        ))}
      </ul>
    </section>
    <section class="lawn-section" aria-labelledby="side-by-side">
      <h2 id="side-by-side">{summary.h2}</h2>
      {summary.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>
    <section class="lawn-section" aria-labelledby="reading">
      <h2 id="reading">How to read the dates</h2>
      {FROST_TEXT.reading.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>{FROST_FOOTNOTE}</p>
    </section>
    <ShareLink title={index.title} {path} />
    <Sources {path} />
  </main>
  <slot />
</Layout>

<style is:global>
  .lawn-main .lawn-states,
  .lawn-main .lawn-cities {
    list-style: none;
    padding: 0;
    columns: 2 12rem;
  }

  .lawn-states li,
  .lawn-cities li {
    break-inside: avoid;
    min-height: 2rem;
  }
</style>
