---
import { FOOD_HUB_FR } from '../../fr/can-dogs-eat.ts';
import { HEADINGS_FR, readOnFr } from '../../fr/texts.ts';
import { hrefOf } from '../../routes.ts';
import Byline from '../Byline.astro';
import Layout from '../Layout.astro';
import ShareLink from '../ShareLink.astro';
import Sources from '../Sources.astro';

const { title, description, h1, lead, checked, sections, budgetColumns, budget, groups, sources } =
  FOOD_HUB_FR;
---

<Layout {title} {description} modified={checked}>
  <main class="bf-page">
    <h1>{h1}</h1>
    <Byline {checked} />
    <p>{lead}</p>
    <p class="bf-call" role="note">
      {FOOD_HUB_FR.callNote}
    </p>
    {groups.map(({ verdict, heading, intro, rows }) => (
      <section aria-labelledby={`v-${verdict}`}>
        <h2 id={`v-${verdict}`}>{heading}</h2>
        <p>{intro}</p>
        <ul class="bf-foods">
          {rows.map(({ href, name, summary }) => (
            <li>
              <a {href}>{name}</a> : {summary}
            </li>
          ))}
        </ul>
      </section>
    ))}
    {sections.map(({ id, heading, paragraphs }) => (
      <section aria-labelledby={id}>
        <h2 {id}>{heading}</h2>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {id === 'budget' && (
          <div
            class="bf-scroll"
            tabindex="0"
            role="region"
            aria-label={`Le budget friandises selon le poids, ${HEADINGS_FR.scrolls}`}
          >
            <table class="bf-table">
              <thead>
                <tr>
                  {budgetColumns.map((column) => (
                    <th scope="col">{column}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {budget.map(([weight, ...cells]) => (
                  <tr>
                    <th scope="row">{weight}</th>
                    {cells.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    ))}
    <p>
      {'Que faire si c’était du chocolat : '}
      <a href={hrefOf('chocolate-guide', 'fr')}>Mon chien a mangé du chocolat</a>
      {'. Et quel âge a votre chien en âge humain : '}
      <a href={hrefOf('dog-age', 'fr')}>le calculateur d’âge du chien</a>
      {'. Toutes les pages en français : '}
      <a href={hrefOf('home', 'fr')}>l’accueil de Bowl Figures en français</a>.
    </p>
    <p>{readOnFr(FOOD_HUB_FR.checkedEnglish, checked)}</p>
    <Sources {sources} />
    <ShareLink path={FOOD_HUB_FR.path} {title} />
  </main>
</Layout>

<style>
  .bf-foods {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }
</style>
