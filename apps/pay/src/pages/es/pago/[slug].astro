---
import LongTailPage from '../../../components/LongTailPage.astro';
import { JOBS, SHIFTS, type Job, type Shift } from '../../../long-tail/jobs.ts';

export const getStaticPaths = () =>
  [...JOBS, ...SHIFTS].map((job) => ({ params: { slug: job.slug.es }, props: { job } }));

interface Props {
  readonly job: Job | Shift;
}
---

<LongTailPage lang="es" job={Astro.props.job} />
