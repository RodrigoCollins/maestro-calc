---
import { MAESTRO, type CalculatorPage } from '../calculators.ts';
import { fieldText } from '../format.ts';
import { guideAt } from '../guide.ts';
import { hrefOf } from '../routes.ts';
import { pageTrailOf } from '../seo/breadcrumb.ts';
import { sizeTableOf } from '../sizes.ts';
import { ENGINES, viewOf } from '../view.ts';
import Layout from './Layout.astro';
import ShareLink from './ShareLink.astro';
import Spreader from './Spreader.astro';

interface Props {
  readonly page: CalculatorPage;
}

const { page } = Astro.props;
const engine = ENGINES[page.id];
// The page renders the engine's default result, so it reads complete with no script.
const view = viewOf(page.id);
const sizes = sizeTableOf(page.id);
if (view === undefined) throw new Error(`${page.id} must run at its defaults`);
const fields = engine.inputs.map((input) => {
  const copy = page.fields[input.key];
  if (copy === undefined) throw new Error(`no label for ${input.key}`);
  return {
    key: input.key,
    ...copy,
    value:
      input.kind === 'select'
        ? input.default
        : input.kind === 'decimal'
          ? fieldText(input.default)
          : '',
    options: copy.options === undefined ? undefined : Object.entries(copy.options),
  };
});
const NPK = ['nitrogen', 'phosphate', 'potash'];
const tiles = fields.filter(({ key }) => NPK.includes(key));
const plain = fields.filter(({ key }) => !NPK.includes(key));
const [firstPlain, ...restPlain] = plain;
const hasTiles = tiles.length === NPK.length;
const guides = page.guides.map((id) => guideAt(hrefOf(id)));
const maestro = [
  MAESTRO.pages.area,
  ...page.maestro.map((id) => MAESTRO.pages[id]),
  MAESTRO.pages.hub,
];
---

<Layout title={page.title} description={page.description} trail={pageTrailOf(page)}>
  <Fragment slot="hero">
    <section class="lawn-hero tall">
      <p class="lawn-kicker">{page.kicker}</p>
      <h1>{page.h1}</h1>
      <p>{page.lead}</p>
    </section>
  </Fragment>
  <main class="lawn-main lifted">
    <form class="lawn-card" data-calculator={page.id} novalidate>
      {firstPlain !== undefined && (
        <label>
          <span>{firstPlain.label}</span>
          <input
            name={firstPlain.key}
            inputmode="decimal"
            autocomplete="off"
            value={firstPlain.value}
          />
          {firstPlain.hint !== undefined && <small>{firstPlain.hint}</small>}
        </label>
      )}
      <details class="lawn-measure lawn-js-only">
        <summary>Measure the lawn</summary>
        <div class="lawn-measure-body">
          <label>
            <span>Length (ft)</span>
            <input data-measure="length" inputmode="decimal" autocomplete="off" />
          </label>
          <label>
            <span>Width (ft)</span>
            <input data-measure="width" inputmode="decimal" autocomplete="off" />
          </label>
          <p>
            <strong data-measure-out>0</strong> sq ft
            <button type="button" data-measure-use>
              Use this area
            </button>
          </p>
          <p>
            An odd shape? Split it into rectangles with the{' '}
            <a href={`${MAESTRO.origin}${MAESTRO.pages.area.path}`}>square footage calculator</a>.
          </p>
        </div>
      </details>
      {hasTiles && (
        <fieldset class="lawn-npk">
          <legend>The three numbers on the bag</legend>
          <div>
            {tiles.map((field) => (
              <label>
                <span>{field.label}</span>
                <input
                  name={field.key}
                  inputmode="decimal"
                  autocomplete="off"
                  value={field.value}
                />
              </label>
            ))}
          </div>
        </fieldset>
      )}
      {restPlain.map((field) => (
        <label>
          <span>{field.label}</span>
          {field.options === undefined ? (
            <input name={field.key} inputmode="decimal" autocomplete="off" value={field.value} />
          ) : (
            <select name={field.key}>
              {field.options.map(([value, label]) => (
                <option value={value} selected={value === field.value}>
                  {label}
                </option>
              ))}
            </select>
          )}
          {field.hint !== undefined && <small>{field.hint}</small>}
        </label>
      ))}
    </form>

    <section class="lawn-result" aria-live="polite" aria-label="Result">
      <div class="lawn-tag">
        <p class="lawn-tag-head">
          {page.tag.head.map((seg) =>
            typeof seg === 'string' ? seg : <span data-v={seg.v}>{view.values[seg.v]}</span>,
          )}
        </p>
        <p class="lawn-tag-sub">
          {page.tag.sub.map((seg) =>
            typeof seg === 'string' ? seg : <span data-v={seg.v}>{view.values[seg.v]}</span>,
          )}
        </p>
      </div>
      <dl class="lawn-rows">
        {page.rows.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>
              <span data-v={row.v}>{view.values[row.v]}</span> {row.unit}
            </dd>
          </div>
        ))}
      </dl>
      {Object.entries(page.warnings).map(([code, text]) => (
        <p class="lawn-warning" data-warning={code} hidden={!view.warnings.includes(code)}>
          {text}
        </p>
      ))}
    </section>

    <ShareLink title={page.title} path={page.path} />

    {page.id === 'grass-seed' && <Spreader perPass={view.values['perPass'] ?? ''} />}

    <section class="lawn-section" aria-labelledby="sizes">
      <h2 id="sizes">By lawn size</h2>
      <p>
        The calculator at the values the form starts with, changing only the lawn area. Change any
        field above for your own figures.
      </p>
      <div class="lawn-sizes" role="region" aria-labelledby="sizes" tabindex="0">
        <table>
          <thead>
            <tr>
              {sizes.columns.map((column) => (
                <th scope="col">{column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {sizes.rows.map(([area, ...cells]) => (
              <tr>
                <th scope="row">{area}</th>
                {cells.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="lawn-math" aria-labelledby="math">
      <h2 id="math">The math</h2>
      <p>{page.method}</p>
      <p>{page.note}</p>
      <p>
        <a href={hrefOf('methodology')}>Formulas, sources and worked cases</a>
      </p>
    </section>

    {guides.length > 0 && (
      <section class="lawn-section" aria-labelledby="guides">
        <h2 id="guides">Read next</h2>
        <ul>
          {guides.map(({ path, card }) => (
            <li>
              <a href={path}>{card.title}</a>
            </li>
          ))}
          <li>
            <a href={hrefOf('frost-index')}>Frost dates for your ZIP</a>
          </li>
        </ul>
      </section>
    )}

    <section class="lawn-section" aria-labelledby="rest">
      <h2 id="rest">For the rest of the yard</h2>
      <ul>
        {maestro.map(({ label, path }) => (
          <li>
            <a href={`${MAESTRO.origin}${path}`}>{label} on Maestro Calc</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <slot />
</Layout>

<style is:global>
  .lawn-sizes {
    overflow-x: auto;
  }

  .lawn-sizes table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .lawn-sizes th,
  .lawn-sizes td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-align: right;
  }

  .lawn-card {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--card);
    border-radius: 1rem;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.18);
  }

  .lawn-card label,
  .lawn-measure-body label {
    display: grid;
    gap: 0.25rem;
    font-weight: 600;
  }

  .lawn-card small {
    font-weight: 400;
    color: var(--muted);
  }

  .lawn-card input,
  .lawn-card select {
    box-sizing: border-box;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--line);
    border-radius: 0.5rem;
    background: var(--ground);
    color: var(--ink);
    font: inherit;
  }

  .lawn-card [aria-invalid='true'] {
    border-color: var(--warn);
  }

  .lawn-npk {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lawn-npk legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .lawn-npk div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  /* the dark green tiles with the yellow digits of the printed bag */
  .lawn-npk label {
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: var(--deep);
    color: var(--on-deep);
    font-size: 0.8125rem;
  }

  .lawn-npk input {
    border-color: var(--on-deep);
    background: var(--deep);
    color: var(--on-deep);
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.75rem;
    text-align: center;
  }

  .lawn-measure summary {
    cursor: pointer;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    font-weight: 600;
    color: var(--link);
  }

  .lawn-measure-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .lawn-measure-body p {
    grid-column: 1 / -1;
    margin: 0;
  }

  .lawn-measure-body button {
    min-height: 2.75rem;
    margin-left: 0.5rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--deep);
    color: var(--on-deep);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  /* the helper writes the area field from a script: with none, type the area */
  @media (scripting: none) {
    .lawn-js-only {
      display: none;
    }
  }

  .lawn-result {
    display: grid;
    gap: 1.25rem;
  }

  /* the seed-bag tag: yellow, tilted, a punched hole and a string */
  .lawn-tag {
    position: relative;
    justify-self: start;
    max-width: 100%;
    box-sizing: border-box;
    margin-top: 1.5rem;
    padding: 1.75rem 2rem 1.25rem 3rem;
    background: var(--yellow);
    color: var(--on-yellow);
    border-radius: 0.5rem 1.5rem 1.5rem 0.5rem;
    transform: rotate(-2.5deg);
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 0.2);
  }

  .lawn-tag::before {
    content: '';
    position: absolute;
    left: 0.9rem;
    top: 50%;
    width: 1rem;
    height: 1rem;
    margin-top: -0.5rem;
    border-radius: 50%;
    background: var(--ground);
    box-shadow: inset 0 0.1rem 0.2rem rgb(0 0 0 / 0.35);
  }

  .lawn-tag::after {
    content: '';
    position: absolute;
    left: 1.35rem;
    bottom: 50%;
    width: 0.125rem;
    height: 2.5rem;
    margin-bottom: 0.1rem;
    background: var(--ink);
    transform: rotate(8deg);
    transform-origin: bottom;
  }

  .lawn-tag p {
    margin: 0;
  }

  .lawn-main .lawn-tag-head {
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(2.5rem, 11vw, 4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .lawn-main .lawn-tag-sub {
    margin-top: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .lawn-rows {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .lawn-rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--line);
  }

  .lawn-rows dt {
    color: var(--muted);
  }

  .lawn-rows dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .lawn-main .lawn-warning {
    padding: 0.75rem 1rem;
    border-left: 0.375rem solid var(--warn);
    color: var(--warn);
    background: var(--card);
    font-weight: 600;
  }

  /* the dark green "math" block */
  .lawn-math {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--deep);
    color: var(--on-stripe);
  }

  .lawn-main .lawn-math a {
    color: var(--on-deep);
  }
</style>
