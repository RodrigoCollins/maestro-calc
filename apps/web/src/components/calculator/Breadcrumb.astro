---
import type { BreadcrumbView } from './model.ts';

interface Props {
  breadcrumb: BreadcrumbView;
}
const { label, homeLabel, homeHref, trail = [], current } = Astro.props.breadcrumb;
// Its rules are global, not scoped: the same selectors, no extra class on each crumb, and only the
// pages that render a breadcrumb carry them (the homes have none).
---

<ol class="calc-breadcrumb" aria-label={label}>
  <li>
    <a class="tap-target" href={homeHref}>
      {homeLabel}
    </a>
  </li>
  {trail.map(({ href, label: name }) => (
    <li>
      <a class="tap-target" {href}>
        {name}
      </a>
    </li>
  ))}
  <li aria-current="page">{current}</li>
</ol>

<style is:global>
  /* The breadcrumb of calculator and guide pages: the home, then the page. */
  .calc-breadcrumb {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    font-size: var(--text-small);
    list-style: none;
  }

  /* each crumb is a flex box, so the 44 px link adds no line box below the text */
  .calc-breadcrumb li {
    display: flex;
    align-items: center;
  }

  .calc-breadcrumb li + li::before {
    content: '/';
    margin-right: var(--space-2);
  }
</style>
