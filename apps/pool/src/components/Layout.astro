---
import { Font } from 'astro:assets';
import { NAV_LINKS } from '../home.ts';
import type { Crumb } from '../seo/breadcrumb.ts';
import { embedHeadOf, headOf } from '../seo/head.ts';
import { jsonLdOf, ogTypeOf, pageKindOf } from '../seo/json-ld.ts';
import { canonicalPath } from '../seo/sitemap.ts';
import { SITE } from '../site.config.ts';

interface Props {
  readonly title: string;
  readonly description: string;
  /** False for a page that is never indexed and has no canonical: the 404. */
  readonly indexed?: boolean;
  /**
   * The embed of the page (`src/embed.ts`), another site's frame: canonical at the full page,
   * `noindex`, no JSON-LD or analytics, every link in a new tab, and no navigation: the footer keeps
   * only its warning (the credit link sits under the frame).
   */
  readonly embed?: boolean;
  /** The breadcrumb of a job page (`src/seo/breadcrumb.ts`): its `BreadcrumbList` joins the JSON-LD. */
  readonly trail?: readonly Crumb[];
}

const { title, description, indexed = true, embed = false, trail } = Astro.props;
const here = canonicalPath(Astro.url.pathname);
const embedHead = embed ? embedHeadOf(here, { title, description }) : undefined;
const path = embedHead?.page ?? here;
const { canonical, robots, preview } = embedHead ?? headOf(path, { title, description }, indexed);
const jsonLd = jsonLdOf(path, { title, description }, SITE.origin, trail);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robots !== undefined && <meta name="robots" content={robots} />}
    {canonical !== undefined && <link rel="canonical" href={canonical} />}
    {embed && <base target="_blank" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogTypeOf(pageKindOf(path))} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={preview['og:title']} />
    <meta property="og:description" content={preview['og:description']} />
    {canonical !== undefined && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={preview['og:image']} />
    <meta property="og:image:width" content={preview['og:image:width']} />
    <meta property="og:image:height" content={preview['og:image:height']} />
    <meta name="twitter:card" content={preview['twitter:card']} />
    {canonical !== undefined && !embed && (
      <script type="application/ld+json" is:inline set:html={jsonLd} />
    )}
    <Font cssVariable="--font-body" preload={[{ weight: '400' }]} />
    <Font cssVariable="--font-display" preload={[{ weight: '700' }]} />
    {SITE.gaId !== '' && !embed && (
      <script
        is:inline
        src="/analytics.js"
        data-ga={SITE.gaId}
        data-host={new URL(SITE.origin).hostname}
        defer
      />
    )}
  </head>
  <body>
    <header class="pool-header">
      <a class="pool-brand" href={embed ? canonical : '/'}>
        {SITE.name}
      </a>
      {!embed && (
        <nav aria-label="Calculators">
          {NAV_LINKS.map(({ href, title }) => (
            <a {href}>{title}</a>
          ))}
        </nav>
      )}
    </header>
    <slot />
    <footer class="pool-footer">
      <p>Every figure is an estimate. Read the label of your product before you add it.</p>
      {!embed && (
        <>
          <p>
            <a href="/methodology">How we work it out</a>
          </p>
          <p>
            <a href="/opening-your-pool">Opening your pool</a>
          </p>
          <p>
            <a href="/closing-your-pool">Closing your pool</a>
          </p>
          <p>
            <a href="/pool-water-chemistry-chart">Water chemistry chart</a>
          </p>
          <p>
            <a href="/pool-chemical-dosing-chart">Chemical dosing chart</a>
          </p>
          <p>
            <a href="/pool-volume-chart">Pool volume chart</a>
          </p>
          <p>
            <a href="/how-long-to-run-pool-pump">How long to run your pump</a>
          </p>
          <p>
            <a href="/salt-water-pool-vs-chlorine-pool">Salt water vs chlorine</a>
          </p>
          <p>
            <a href="/how-to-shock-a-pool">How to shock a pool</a>
          </p>
          <p>
            <a href="/how-to-lower-ph-in-a-pool">How to lower pool pH</a>
          </p>
          <p>
            <a href="/how-to-raise-calcium-hardness-in-a-pool">How to raise calcium hardness</a>
          </p>
          <p>
            <a href="/privacy">Privacy</a>
          </p>
          <p>
            <a href="/about">About</a>
          </p>
          <p>
            <a href="/embed-calculators">Embed our calculators</a>
          </p>
        </>
      )}
    </footer>
  </body>
</html>

<style is:global>
  /* Depth marker (plans/pool/PLAN.md): white tile with joint lines, ink, deep teal for actions. */
  :root {
    --tile: #fafaf7;
    --joint: #e4e4dc;
    --ink: #111111;
    --teal: #0b6e7f;
    color: var(--ink);
    font-family: var(--font-body), Arial, sans-serif;
  }

  body {
    margin: 0;
    background-color: var(--tile);
    background-image:
      linear-gradient(var(--joint) 1px, transparent 1px),
      linear-gradient(90deg, var(--joint) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
  }

  .pool-page {
    max-width: 40rem;
    margin: 0 auto;
    padding: 3rem 1rem;
    display: grid;
    gap: 1.5rem;
  }

  .pool-page h1 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 1;
  }

  .pool-page p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* The result as a depth-marker tile: a big condensed figure and its unit on the tile. */
  .pool-marker {
    justify-self: start;
    padding: 1rem 1.5rem;
    border: 3px solid var(--ink);
    background: #ffffff;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: clamp(2.5rem, 10vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .pool-marker small {
    display: block;
    font-size: 0.35em;
    letter-spacing: 0.08em;
  }

  .pool-page a {
    color: var(--teal);
  }

  /* A white bar with an ink rule: the wordmark, then the calculators. */
  .pool-header,
  .pool-footer {
    background: #ffffff;
  }

  .pool-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.75rem max(1rem, calc((100% - 68rem) / 2));
    border-bottom: 3px solid var(--ink);
  }

  .pool-header a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
  }

  .pool-brand {
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .pool-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pool-footer {
    padding: 1.25rem max(1rem, calc((100% - 68rem) / 2));
    border-top: 3px solid var(--ink);
  }

  .pool-footer p {
    margin: 0;
    font-size: 0.875rem;
  }

  .pool-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .pool-footer a {
    color: var(--teal);
  }
</style>
