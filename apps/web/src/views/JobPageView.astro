---
import type { Locale } from '@maestro-calc/i18n';
import Breadcrumb from '../components/calculator/Breadcrumb.astro';
import Byline from '../components/Byline.astro';
import GuideCta from '../components/GuideCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { jobView } from '../lib/job-view.ts';
import { bylineOf, calculatorSourcesHref, CHART_SOURCES_ID } from '../lib/byline.ts';
import { calendarDay } from '../lib/calendar-day.ts';
import { siteText } from '../lib/site-text.ts';
import { JOBS, type JobId } from '../routing/jobs.ts';
import { pathOf } from '../routing/routes.ts';
import { headFor } from '../seo/head.ts';
import { jobJsonLd, serializeJsonLd, type JobPage } from '../seo/json-ld.ts';
import { getEntry } from 'astro:content';
import { headingOf } from '../content/heading.ts';
import { hubOfCalculator } from '../routing/hubs.ts';

/*
 * A job page (growth plan, lever 1): the answer for one common job and its table, every figure
 * worked out at build time by the engine the calculator runs, each size linked to the calculator
 * with that size filled in. No script.
 */
interface Props {
  id: JobId;
  locale: Locale;
}
const { id, locale } = Astro.props;
const text = siteText(locale);
const view = jobView(id, locale);
const { chart } = view;
const { updated, calculator } = JOBS[id];
// Signed by the editorial team on the day its row was checked: a chart points at its own sources,
// any other job at the sources of its calculator.
const byline = bylineOf(
  locale,
  updated,
  chart === undefined ? calculatorSourcesHref(calculator, locale) : `#${CHART_SOURCES_ID}`,
);
// The trail the page sits on, each page named by its h1: its calculator's hub, then the calculator.
const hub = hubOfCalculator(calculator);
if (hub === undefined) throw new Error(`the calculator of job ${id} has no hub`);
const hubEntry = await getEntry('pages', `${locale}/${hub}`);
if (hubEntry === undefined) throw new Error(`no content entry for ${locale}/${hub}`);
const trail = [
  { id: hub, name: headingOf(hubEntry.body ?? '') },
  { id: calculator, name: view.calculatorName },
];
const breadcrumb = {
  label: text('site.calculator.breadcrumb'),
  homeLabel: text('site.calculator.breadcrumbHome'),
  homeHref: pathOf('home', locale),
  trail: trail.map((crumb) => ({ href: pathOf(crumb.id, locale), label: crumb.name })),
  current: view.heading,
};
// One source is named by its address, several by the list of them.
const basedOnOf = ([first, ...rest]: NonNullable<typeof chart>['sources']) => {
  const [second, ...more] = rest;
  return second === undefined
    ? first.source.url
    : ([first.source.url, second.source.url, ...more.map(({ source }) => source.url)] as const);
};
// A reference chart is also a dataset: its description, its day and the data sheet it rests on.
const page: JobPage =
  chart === undefined
    ? { id, name: view.heading, trail }
    : {
        id,
        name: view.heading,
        trail,
        dataset: {
          description: text(`page.${id}.description`),
          updated,
          basedOn: basedOnOf(chart.sources),
        },
      };
const jsonLd = serializeJsonLd(jobJsonLd(page, locale));
---

<BaseLayout {locale} {id} head={{ ...headFor(id, locale, text), jsonLd }}>
  <Breadcrumb {breadcrumb} />
  <article class="prose">
    <h1>{view.heading}</h1>
    <Byline {byline} />
    {view.intro !== undefined && <p>{view.intro}</p>}
    {chart === undefined && (
      <>
        <p class="job-size">{view.lead}</p>
        <p class="job-answer">{view.answer}</p>
        <dl class="job-facts">
          {view.facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </>
    )}
    <p>
      {view.note} <a href={view.methodology}>{text('site.job.methodology')}</a>
    </p>
    <h2>{chart === undefined ? text('site.job.cases') : chart.table}</h2>
    <div class="job-table">
      <table>
        <thead>
          <tr>
            {view.columns.map((label) => (
              <th scope="col">{label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {view.rows.map((row) => (
            <tr>
              <th scope="row">
                {row.href === undefined ? row.label : <a href={row.href}>{row.label}</a>}
              </th>
              {row.cells.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {chart?.reverse !== undefined && (
      <>
        <h2>{chart.reverse.heading}</h2>
        <p>{chart.reverse.lead}</p>
        <div class="job-table">
          <table>
            <thead>
              <tr>
                {chart.reverse.columns.map((label) => (
                  <th scope="col">{label}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {chart.reverse.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    {chart !== undefined && (
      <>
        <h2 id={CHART_SOURCES_ID}>{text('site.job.chart.sources')}</h2>
        {chart.sources.length === 1 ? (
          chart.sources.map(({ label, source }) => (
            <p>
              {label}: {source.name}, <code>{source.url}</code>, {text('site.job.chart.retrieved')}{' '}
              {calendarDay(source.retrieved, locale)}.
            </p>
          ))
        ) : (
          <ul>
            {chart.sources.map(({ label, source }) => (
              <li>
                {label}: {source.name}, <code>{source.url}</code>,{' '}
                {text('site.job.chart.retrieved')} {calendarDay(source.retrieved, locale)}.
              </li>
            ))}
          </ul>
        )}
        <h3>{chart.basis}</h3>
        <dl class="job-facts">
          {chart.facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <h2>{text('site.job.chart.cite')}</h2>
        <p>{text('site.job.chart.citeLead')}</p>
        <p class="job-cite">{chart.citation}</p>
        <p>
          <a href={pathOf('charts', locale)}>{text('site.job.chart.index')}</a>
        </p>
      </>
    )}
    <GuideCta label={text('site.guide.cta')} href={view.cta} name={view.calculatorName} />
    {view.others.length > 0 && (
      <>
        <h2>{text('site.job.more')}</h2>
        <ul>
          {view.others.map(({ href, title }) => (
            <li>
              <a {href}>{title}</a>
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .job-size {
    margin-bottom: 0;
    color: var(--color-text-secondary);
  }

  .job-answer {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 700;
  }

  .job-facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--color-line);
  }

  .job-facts dd {
    margin: 0;
    font-weight: 700;
  }

  .job-cite {
    padding: var(--space-2);
    border-left: 3px solid var(--color-line);
    overflow-wrap: anywhere;
  }

  /* A phone scrolls the table, never the page. */
  .job-table {
    overflow-x: auto;
  }

  .job-table table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .job-table th,
  .job-table td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-line);
    text-align: right;
  }

  .job-table th:first-child {
    text-align: left;
  }
</style>
