---
import { HOME_FR } from '../../fr/home.ts';
import Layout from '../Layout.astro';
---

<Layout title={HOME_FR.title} description={HOME_FR.description}>
  <main class="bf-page">
    <h1>{HOME_FR.h1}</h1>
    <p>{HOME_FR.lead}</p>
    <div class="bf-cards">
      {HOME_FR.cards.map(({ href, title, summary }, index) => (
        <section class="bf-card" aria-labelledby={`carte-${String(index)}`}>
          <h2 id={`carte-${String(index)}`}>
            <a {href}>{title}</a>
          </h2>
          <p>{summary}</p>
        </section>
      ))}
    </div>
    {HOME_FR.approach.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <section class="bf-card mint" aria-labelledby="alle">
      <h2 id="alle">{HOME_FR.foodsHeading}</h2>
      <ul>
        {HOME_FR.foods.map(({ href, label }) => (
          <li>
            <a {href}>{label}</a>
          </li>
        ))}
      </ul>
    </section>
    <p>
      {HOME_FR.trust.text}{' '}
      {HOME_FR.trust.links.map(({ href, label }, index) => (
        <>
          {index > 0 && ' · '}
          <a {href}>{label}</a>
        </>
      ))}
    </p>
    <p>
      {HOME_FR.english.text}{' '}
      <a href={HOME_FR.english.href} hreflang="en">
        {HOME_FR.english.label}
      </a>
    </p>
  </main>
</Layout>
