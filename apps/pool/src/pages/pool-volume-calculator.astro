---
import { ft3, gal, isQuantityOf, liter, type Quantity } from '@maestro-calc/core';
import { poolVolume } from '@maestro-calc/pool-core/pool-volume';
import Layout from '../components/Layout.astro';
import { lengthFieldText, volumeText } from '../format.ts';
import { VOLUME_TEXTS as t } from '../volume/texts.ts';

// The page renders the engine's default result, so it reads complete with no script.
const ran = poolVolume.run({});
if (!ran.ok) throw new Error('the pool volume calculator must run at its defaults');
const out = new Map<string, unknown>(ran.value.outputs.map(({ key, value }) => [key, value]));
const volume = (key: string): Quantity<'volume'> => {
  const value = out.get(key);
  if (!isQuantityOf(value, 'volume')) throw new Error(`no volume ${key}`);
  return value;
};
const fields = poolVolume.inputs.map((input) => ({
  key: input.key,
  label: t.fields[input.key].label,
  value: input.kind === 'length' ? lengthFieldText(input.default) : String(input.default),
  options: input.kind === 'select' ? Object.entries(t.fields.shape.options) : undefined,
}));
const rows = [
  { key: 'liters', label: t.rows.liters, value: volumeText(volume('liters'), liter) },
  { key: 'cubicFeet', label: t.rows.cubicFeet, value: volumeText(volume('cubicFeet'), ft3, 1) },
];
---

<Layout title={t.title} description={t.description}>
  <main class="pool-page">
    <p class="pool-kicker">{t.kicker}</p>
    <h1>{t.h1}</h1>
    <p>{t.lead}</p>
    <form class="pool-form" data-calculator="pool-volume" novalidate>
      {fields.map((field) => (
        <label>
          {field.label}
          {field.options === undefined ? (
            <input name={field.key} autocomplete="off" value={field.value} />
          ) : (
            <select name={field.key}>
              {field.options.map(([value, label]) => (
                <option value={value} selected={value === field.value}>
                  {label}
                </option>
              ))}
            </select>
          )}
        </label>
      ))}
    </form>
    <section class="pool-result" aria-live="polite" aria-labelledby="figure-label">
      <p id="figure-label">{t.figureLabel}</p>
      <p class="pool-marker">
        <span data-out="gallons">{volumeText(volume('gallons'), gal)}</span>
        <small>{t.unit}</small>
      </p>
      <dl>
        {rows.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd data-out={row.key}>{row.value}</dd>
          </div>
        ))}
      </dl>
    </section>
    <p class="pool-note">{t.method}</p>
    <p class="pool-note">{t.note}</p>
  </main>
  <script src="../client/pool-volume.ts"></script>
</Layout>

<style is:global>
  .pool-kicker {
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--teal);
  }

  .pool-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
  }

  .pool-form label {
    display: grid;
    gap: 0.375rem;
    font-weight: 600;
  }

  .pool-form input,
  .pool-form select {
    min-height: 3.5rem;
    padding: 0 0.75rem;
    border: 2px solid var(--ink);
    background: #ffffff;
    font:
      700 1.5rem var(--font-display),
      'Arial Narrow',
      sans-serif;
  }

  .pool-form input:focus-visible,
  .pool-form select:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
  }

  .pool-form [aria-invalid='true'] {
    border-color: #c2261e;
  }

  .pool-result {
    display: grid;
    gap: 0.75rem;
  }

  .pool-result dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
  }

  .pool-result dt {
    font-size: 0.9375rem;
  }

  .pool-result dd {
    margin: 0;
    font:
      700 1.5rem var(--font-display),
      'Arial Narrow',
      sans-serif;
    font-variant-numeric: tabular-nums;
  }

  .pool-page .pool-note {
    font-size: 0.9375rem;
  }
</style>
