---
import LongTailPage from '../../components/LongTailPage.astro';
import { LONG_TAIL_JOBS, type LongTailJob } from '../../long-tail/jobs.ts';

export const getStaticPaths = () =>
  LONG_TAIL_JOBS.map((job) => ({ params: { slug: job.slug.en }, props: { job } }));

interface Props {
  readonly job: LongTailJob;
}
---

<LongTailPage lang="en" job={Astro.props.job} />
