---
import Layout from '../components/Layout.astro';
import { OPENING_GUIDE } from '../guide.ts';

const { title, description, h1, lead, steps, sources } = OPENING_GUIDE;
const sourceOf = (key: string) => sources[key as keyof typeof sources];
---

<Layout {title} {description}>
  <main class="pool-page">
    <p class="pool-kicker">Guide · spring</p>
    <h1>{h1}</h1>
    <p>{lead}</p>
    <ol class="pool-steps">
      {steps.map((step) => (
        <li>
          <h2>{step.title}</h2>
          <p>{step.text}</p>
          {'link' in step && (
            <p>
              <a href={step.link.href}>{step.link.label}</a>
            </p>
          )}
          {'sources' in step && (
            <p class="pool-step-source">
              Source:{' '}
              {step.sources.map((key, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={sourceOf(key).url}>{sourceOf(key).name}</a>
                </>
              ))}
            </p>
          )}
        </li>
      ))}
    </ol>
    <p class="pool-note">
      Read the label of each product before you add it, and follow it where it differs from this
      guide.
    </p>
  </main>
</Layout>

<style>
  .pool-steps {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  /* Each step is a tile numbered like a depth marker. */
  .pool-steps li {
    counter-increment: step;
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 3px solid var(--ink);
    background: #ffffff;
  }

  .pool-steps h2 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
    text-transform: uppercase;
    line-height: 1;
  }

  .pool-steps h2::before {
    content: counter(step) '. ';
  }

  .pool-steps p {
    margin: 0;
    line-height: 1.5;
  }

  .pool-step-source {
    font-size: 0.875rem;
  }
</style>
