---
import SiteLayout from '../components/SiteLayout.astro';
import { HOME_TEXTS } from '../home/texts.ts';
---

<SiteLayout
  lang="en"
  title="Page not found · Página no encontrada | Cuenta Horas"
  description="This page does not exist. Esta página no existe."
  otherLang="Español"
  footer={HOME_TEXTS.en.sources}
>
  <main class="page">
    <h1>Page not found</h1>
    <p class="lead">The link may be old or mistyped. Every calculator is on the home page.</p>
    <a class="button button-primary" href="/">
      Go to the home page
    </a>
    <div lang="es">
      <h2>Página no encontrada</h2>
      <p class="lead">
        El link puede estar desactualizado o mal escrito. Todas las calculadoras están en el inicio.
      </p>
      <a class="button button-secondary" href="/es">
        Ir al inicio
      </a>
    </div>
  </main>
</SiteLayout>
