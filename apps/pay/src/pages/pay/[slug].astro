---
import LongTailPage from '../../components/LongTailPage.astro';
import { LONG_TAIL_JOBS, longTailPageOf, type LongTailPage as Page } from '../../long-tail/jobs.ts';
import { SCHOOL_YEAR } from '../../long-tail/routes.ts';
import { schoolYearPage } from '../../long-tail/school-year.ts';

export const getStaticPaths = () => [
  ...LONG_TAIL_JOBS.map((job) => ({
    params: { slug: job.slug.en },
    props: { page: longTailPageOf(job, 'en') },
  })),
  // English only, so it is not one of the paired jobs
  { params: { slug: SCHOOL_YEAR.slug.en }, props: { page: schoolYearPage } },
];

interface Props {
  readonly page: Page;
}
---

<LongTailPage lang="en" page={Astro.props.page} />
