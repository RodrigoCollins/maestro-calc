---
import type { FillSplit, ShoppingLineView } from './model.ts';

interface Props {
  line: ShoppingLineView;
  index: number;
}
const { line, index } = Astro.props;
const { unit, qty, label, note } = line;
const named = (split: FillSplit): split is FillSplit & { readonly name: string } =>
  split.name !== undefined;
---

<p class="calc-shopping" data-line={index}>
  <span class="calc-label">
    {label.before}
    {named(label) && <span data-fill={label.name}>{label.value}</span>}
    {label.after}
  </span>
  <span class="calc-figure calc-qty" data-shopping={unit}>
    {qty}
  </span>
</p>
{note !== undefined && (
  <p class="calc-note" data-line-note={index}>
    {note.before}
    {named(note) && <span data-fill={note.name}>{note.value}</span>}
    {note.after}
  </p>
)}
