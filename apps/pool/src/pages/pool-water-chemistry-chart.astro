---
import Layout from '../components/Layout.astro';
import { CHEMISTRY_CHART } from '../chemistry.ts';

const { title, description, h1, lead, gallons, rows, sources } = CHEMISTRY_CHART;
const sourceOf = (key: string) => sources[key as keyof typeof sources];
---

<Layout {title} {description}>
  <main class="pool-page">
    <p class="pool-kicker">Guide · water chemistry</p>
    <h1>{h1}</h1>
    <p>{lead}</p>
    <table class="pool-chart">
      <caption>Target levels (ppm is parts per million)</caption>
      <thead>
        <tr>
          <th scope="col">Level</th>
          <th scope="col">Home pool</th>
          <th scope="col">Public pool</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ id, name, home, publicPool }) => (
          <tr>
            <th scope="row">
              <a href={`#${id}`}>{name}</a>
            </th>
            <td>{home}</td>
            <td>{publicPool}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      {gallons.text} <a href={gallons.href}>{gallons.label}</a>
    </p>
    {rows.map(({ id, name, home, publicPool, text, link, example, sources: keys }) => (
      <section class="pool-level" aria-labelledby={id}>
        <h2 {id}>{name}</h2>
        <dl>
          <dt>Home pool</dt>
          <dd>{home}</dd>
          <dt>Public pool</dt>
          <dd>{publicPool}</dd>
        </dl>
        <p>{text}</p>
        {example !== undefined && (
          <p>
            {example.text}{' '}
            <strong>
              {example.result} {example.unit}
            </strong>
          </p>
        )}
        {link !== undefined && (
          <p>
            <a href={link.href}>{link.label}</a>
          </p>
        )}
        <p class="pool-level-source">
          Source:{' '}
          {keys.map((key, index) => (
            <>
              {index > 0 && ', '}
              <a href={sourceOf(key).url}>{sourceOf(key).name}</a>
            </>
          ))}
        </p>
      </section>
    ))}
    <p class="pool-note">
      Home-pool ranges are the manufacturer’s; your state may set its own rules for a public pool.
      Read the label of each product before you add it.
    </p>
  </main>
</Layout>

<style>
  .pool-chart {
    width: 100%;
    border-collapse: collapse;
    border: 3px solid var(--ink);
    background: #ffffff;
    line-height: 1.35;
  }

  .pool-chart caption {
    padding-bottom: 0.5rem;
    text-align: left;
    font-weight: 600;
  }

  .pool-chart th,
  .pool-chart td {
    padding: 0.625rem 0.5rem;
    border-top: 1px solid var(--joint);
    text-align: left;
    vertical-align: top;
  }

  .pool-chart thead th {
    border-top: 0;
    border-bottom: 3px solid var(--ink);
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
  }

  .pool-level {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 3px solid var(--ink);
    background: #ffffff;
  }

  .pool-level h2 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
    text-transform: uppercase;
    line-height: 1;
  }

  .pool-level dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  .pool-level dt {
    font-weight: 600;
  }

  .pool-level dd {
    margin: 0;
  }

  .pool-level p {
    margin: 0;
    line-height: 1.5;
  }

  .pool-level strong {
    font-weight: 600;
    white-space: nowrap;
  }

  .pool-level-source {
    font-size: 0.875rem;
  }
</style>
