---
import { SITE } from '../site.config.ts';

interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="wordmark tap-target" {href}>
  <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
    <rect width="28" height="28" rx="6" fill="#0e2240" />
    <path
      d="M8 20v-7M12 20V9M16 20v-5M20 20V7"
      stroke="#f06a1d"
      stroke-width="2.5"
      stroke-linecap="round"
    />
  </svg>
  {SITE.name}
</a>

<style is:global>
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    gap: var(--space-2);
  }
</style>
