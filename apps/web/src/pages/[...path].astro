---
import type { Locale } from '@maestro-calc/i18n';
import { pathOf, staticPaths } from '../routing/routes.ts';
import type { PageId } from '../routing/routes.ts';
import { isCalculatorPage, templateOf } from '../routing/templates.ts';
import CalculatorView from '../views/CalculatorView.astro';
import EmbedSnippets from '../components/EmbedSnippets.astro';
import GuideCta from '../components/GuideCta.astro';
import HubDirectory from '../components/HubDirectory.astro';
import { getEntry } from 'astro:content';
import { headingOf } from '../content/heading.ts';
import { homeCards } from '../lib/home-directory.ts';
import { hubOf } from '../routing/hubs.ts';
import { pageView } from '../lib/pages.ts';
import { siteText } from '../lib/site-text.ts';
import { guideOf } from '../routing/guides.ts';
import { snippetsFor } from '../lib/embed-snippet.ts';
import TrustPageView from '../views/TrustPageView.astro';

// The two homes render from `index.astro` and `es.astro`, so the home view's scoped CSS ships on them only.
export const getStaticPaths = () =>
  staticPaths().filter(({ props }) => templateOf(props.id) !== 'home');

interface Props {
  id: Exclude<PageId, 'home'>;
  locale: Locale;
}

const { id, locale } = Astro.props;
const guide = guideOf(id);
const hub = hubOf(id);
const hubView =
  hub === undefined
    ? undefined
    : {
        calculators: homeCards(locale).filter((card) =>
          (hub.calculators as readonly string[]).includes(card.id),
        ),
        guides: await Promise.all(
          hub.guides.map(async (guideId) => {
            const entry = await getEntry('pages', `${locale}/${guideId}`);
            if (entry === undefined) throw new Error(`no content entry for ${locale}/${guideId}`);
            return { href: pathOf(guideId, locale), title: headingOf(entry.body ?? '') };
          }),
        ),
      };
---

{/* A calculator id has its own template; every other id is a Markdown trust page. */}
{isCalculatorPage(id) ? (
  <CalculatorView {id} {locale} />
) : (
  <TrustPageView {id} {locale}>
    {id === 'embed-calculators' && <EmbedSnippets snippets={snippetsFor(locale)} />}
    {hubView !== undefined && (
      <HubDirectory
        calculatorsLabel={siteText(locale)('site.hub.calculators')}
        guidesLabel={siteText(locale)('site.hub.guides')}
        calculators={hubView.calculators}
        guides={hubView.guides}
      />
    )}
    {guide !== undefined && (
      <GuideCta
        label={siteText(locale)('site.guide.cta')}
        href={pathOf(guide.calculator, locale)}
        name={pageView(guide.calculator, locale).title}
      />
    )}
  </TrustPageView>
)}
