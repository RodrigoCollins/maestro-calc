---
import { POISON_LINE } from '../calc/chocolate.ts';
import { checkedText } from '../editorial.ts';
import { HELPLINE } from '../plants/sources.ts';
import { PLANT_CALL, plantPageOf } from '../toxic-plants.ts';
import Byline from './Byline.astro';
import Layout from './Layout.astro';
import ShareLink from './ShareLink.astro';
import Sources from './Sources.astro';

interface Props {
  readonly path: string;
}

const page = plantPageOf(Astro.props.path);
const { title, description, h1, lead, checked, table, sections, alternatives, questions } = page;
---

<Layout {title} {description} modified={checked}>
  <main class="bf-page">
    <h1>{h1}</h1>
    <Byline {checked} />
    <p>{lead}</p>
    {page.callNow && (
      <p class="bf-call" role="note">
        {PLANT_CALL} <a href={POISON_LINE.href}>{POISON_LINE.phone}</a>
        {' · '}
        <a href={HELPLINE.href}>{HELPLINE.phone}</a>
      </p>
    )}
    <section aria-labelledby="aspca">
      <h2 id="aspca">{table.heading}</h2>
      {table.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div
        class="bf-scroll"
        tabindex="0"
        role="region"
        aria-label={`${table.heading}, scrolls sideways on a narrow screen`}
      >
        <table class="bf-table">
          <thead>
            <tr>
              {table.columns.map((column) => (
                <th scope="col">{column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {table.rows.map(([name, ...cells]) => (
              <tr>
                <th scope="row">{name}</th>
                {cells.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    {sections.map(({ id, heading, paragraphs }) => (
      <section aria-labelledby={id}>
        <h2 {id}>{heading}</h2>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    ))}
    <section aria-labelledby="instead">
      <h2 id="instead">Plants the ASPCA lists as non-toxic to cats and dogs</h2>
      <ul>
        {alternatives.map(({ href, label }) => (
          <li>
            <a {href}>{label}</a>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="faq">
      <h2 id="faq">Frequently asked questions</h2>
      {questions.map(({ question, answer }) => (
        <>
          <h3>{question}</h3>
          <p>{answer}</p>
        </>
      ))}
    </section>
    <section class="bf-card mint" aria-labelledby="bf-plants">
      <h2 id="bf-plants">More plants with the same answer</h2>
      <ul class="bf-ages">
        {page.related.map(({ href, label }) => (
          <li>
            <a {href}>{label}</a>
          </li>
        ))}
      </ul>
      <ul>
        {page.links.map(({ href, label }) => (
          <li>
            <a {href}>{label}</a>
          </li>
        ))}
      </ul>
    </section>
    <p>{`Every source below was read on ${checkedText(checked)}.`}</p>
    <Sources sources={page.sources} />
    <ShareLink path={page.path} {title} />
  </main>
</Layout>
