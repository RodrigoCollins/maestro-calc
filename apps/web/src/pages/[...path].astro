---
import type { Locale } from '@maestro-calc/i18n';
import { pathOf, staticPaths } from '../routing/routes.ts';
import type { PageId } from '../routing/routes.ts';
import { templateOf } from '../routing/templates.ts';
import type { CalculatorPageId } from '../routing/templates.ts';
import EmbedSnippets from '../components/EmbedSnippets.astro';
import GlossaryTable from '../components/GlossaryTable.astro';
import GuideCta from '../components/GuideCta.astro';
import GuidesIndex from '../components/GuidesIndex.astro';
import ChartsIndex from '../components/ChartsIndex.astro';
import SourceIndex from '../components/SourceIndex.astro';
import { sourceIndex } from '../lib/source-index.ts';
import { CALCULATOR_PAGES } from '../routing/templates.ts';
import { guideGroups } from '../lib/guides-index.ts';
import { chartCards } from '../lib/charts-index.ts';
import type { GuideId } from '../routing/guides.ts';
import HubDirectory from '../components/HubDirectory.astro';
import { getEntry } from 'astro:content';
import { headingOf } from '../content/heading.ts';
import { homeCards } from '../lib/home-directory.ts';
import { hubOf } from '../routing/hubs.ts';
import { pageView } from '../lib/pages.ts';
import { siteText } from '../lib/site-text.ts';
import { guideOf } from '../routing/guides.ts';
import { snippetsFor } from '../lib/embed-snippet.ts';
import { glossaryView } from '../lib/glossary-view.ts';
import TrustPageView from '../views/TrustPageView.astro';
import JobPageView from '../views/JobPageView.astro';
import PitchDegreesTable from '../components/PitchDegreesTable.astro';
import { pitchDegreesView } from '../lib/pitch-degrees.ts';
import { isJobPage } from '../routing/jobs.ts';
import { jobLinks } from '../lib/job-links.ts';

// The two homes render from `index.astro` and `es.astro`, and the calculator pages from
// `[calculator].astro` and `es/[calculator].astro`, so their views' scoped CSS ships on them only.
export const getStaticPaths = () =>
  staticPaths().filter(({ props }) => !['home', 'calculator'].includes(templateOf(props.id)));

interface Props {
  id: Exclude<PageId, 'home' | CalculatorPageId>;
  locale: Locale;
}

const { id, locale } = Astro.props;
const guide = guideOf(id);
const hub = hubOf(id);
const guideCard = async (guideId: GuideId) => {
  const entry = await getEntry('pages', `${locale}/${guideId}`);
  if (entry === undefined) throw new Error(`no content entry for ${locale}/${guideId}`);
  return {
    href: pathOf(guideId, locale),
    title: headingOf(entry.body ?? ''),
    summary: siteText(locale)(`page.${guideId}.description`),
  };
};
const guideIndex =
  id === 'guides'
    ? await Promise.all(
        guideGroups().map(async (group) => ({
          heading: siteText(locale)(
            group.hub === null ? 'site.guides.business' : `site.footer.${group.hub}`,
          ),
          guides: await Promise.all(group.guides.map(guideCard)),
        })),
      )
    : undefined;
// The editorial policy ends with every source of the calculator entries of its locale.
const sources =
  id === 'editorial-policy'
    ? sourceIndex(
        await Promise.all(
          CALCULATOR_PAGES.map(async (calculator) => {
            const entry = await getEntry('calculators', `${locale}/${calculator}`);
            if (entry === undefined)
              throw new Error(`no calculator entry for ${locale}/${calculator}`);
            return entry.data;
          }),
        ),
      )
    : undefined;
const hubView =
  hub === undefined
    ? undefined
    : {
        calculators: homeCards(locale).filter((card) =>
          (hub.calculators as readonly string[]).includes(card.id),
        ),
        guides: await Promise.all(hub.guides.map(guideCard)),
        jobs: hub.calculators.flatMap((calculator) => jobLinks(calculator, locale)),
      };
---

{/* A job id has its own template; every other id is a Markdown trust page. */}
{isJobPage(id) ? (
  <JobPageView {id} {locale} />
) : (
  <TrustPageView {id} {locale}>
    {id === 'embed-calculators' && <EmbedSnippets snippets={snippetsFor(locale)} />}
    {id === 'glossary' && <GlossaryTable view={glossaryView(locale)} />}
    {guideIndex !== undefined && <GuidesIndex groups={guideIndex} />}
    {id === 'charts' && (
      <ChartsIndex
        cards={chartCards(locale)}
        checkedLabel={siteText(locale)('site.charts.checked')}
        sourcesLabel={siteText(locale)('site.charts.sources')}
        press={{
          heading: siteText(locale)('site.charts.press.heading'),
          text: siteText(locale)('site.charts.press.text'),
        }}
      />
    )}
    {hubView !== undefined && (
      <HubDirectory
        calculatorsLabel={siteText(locale)('site.hub.calculators')}
        guidesLabel={siteText(locale)('site.hub.guides')}
        calculators={hubView.calculators}
        guides={hubView.guides}
        jobsLabel={siteText(locale)('site.hub.jobs')}
        jobs={hubView.jobs}
      />
    )}
    {sources !== undefined && (
      <SourceIndex
        id={locale === 'en' ? 'all-sources' : 'todas-las-fuentes'}
        heading={siteText(locale)('site.editorial.sources')}
        {sources}
      />
    )}
    {id === 'hub-roofing' && <PitchDegreesTable view={pitchDegreesView(locale)} />}
    {guide !== undefined && (
      <GuideCta
        label={siteText(locale)('site.guide.cta')}
        href={pathOf(guide.calculator ?? 'home', locale)}
        name={
          guide.calculator === null
            ? siteText(locale)('site.guide.allCalculators')
            : pageView(guide.calculator, locale).title
        }
      />
    )}
  </TrustPageView>
)}
