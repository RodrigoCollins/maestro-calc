// Root tooling program: .ts files are type-checked; .js files are only parsed (allowJs, no checkJs
// until task 2.14), so JS configs are covered by lint alone.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    // skipLibCheck: eslint-import-context (via eslint-plugin-import-x) ships declarations that
    // import the uninstalled `type-fest`. Remove once `tsc -p tsconfig.json` passes without it.
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.config.js", "*.config.ts", "tooling"],
  // tooling/site-browser typechecks itself with its own tsconfig and install.
  "exclude": ["tooling/site-browser"]
}
