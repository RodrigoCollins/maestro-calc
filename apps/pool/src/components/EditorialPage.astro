---
import Layout from './Layout.astro';
import { EDITORIAL_TEXTS } from '../editorial.ts';
import type { Lang } from '../routes.ts';

interface Props {
  readonly lang: Lang;
}

const { title, description, h1, lead, sections, reviewed } = EDITORIAL_TEXTS[Astro.props.lang];
---

<Layout {title} {description}>
  <main class="pool-page">
    <h1>{h1}</h1>
    <p>{lead}</p>
    {sections.map(({ id, heading, paragraphs, sources, link }) => (
      <section class="pool-editorial" aria-labelledby={id}>
        <h2 {id}>{heading}</h2>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {sources !== undefined && (
          <ul>
            {sources.map(({ name, url }) => (
              <li>
                <a href={url}>{name}</a>
              </li>
            ))}
          </ul>
        )}
        {link !== undefined && (
          <p>
            <a href={link.href}>{link.label}</a>
          </p>
        )}
      </section>
    ))}
    <p class="pool-editorial-note">{reviewed}</p>
  </main>
</Layout>

<style>
  .pool-editorial {
    display: grid;
    gap: 0.75rem;
  }

  .pool-editorial h2 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
  }

  .pool-editorial ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.5;
  }

  .pool-page .pool-editorial-note {
    font-size: 0.875rem;
  }
</style>
