---
import LongTailPage from '../../components/LongTailPage.astro';
import { JOBS, type Job } from '../../long-tail/jobs.ts';

export const getStaticPaths = () =>
  JOBS.map((job) => ({ params: { slug: job.slug.en }, props: { job } }));

interface Props {
  readonly job: Job;
}
---

<LongTailPage lang="en" job={Astro.props.job} />
