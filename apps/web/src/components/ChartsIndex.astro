---
import type { ChartCard } from '../lib/charts-index.ts';

/*
 * The data and charts index: every reference chart with its line, the day its figures were
 * checked and who publishes its sources, then the note for journalists. The day is text, not a
 * `<time>`: the page's one `<time>` is its own update day.
 */
interface Props {
  cards: readonly ChartCard[];
  checkedLabel: string;
  sourcesLabel: string;
  press: { heading: string; text: string };
}
const { cards, checkedLabel, sourcesLabel, press } = Astro.props;
---

<section class="charts-index">
  <ul class="charts-cards" role="list">
    {cards.map(({ href, title, summary, checked, owners }) => (
      <li class="charts-card">
        <a class="tap-target" {href}>
          {title}
        </a>
        <p>{summary}</p>
        <p class="charts-meta">
          {checkedLabel} {checked} · {sourcesLabel} {owners.join(', ')}
        </p>
      </li>
    ))}
  </ul>
</section>
<section class="charts-press">
  <h2>{press.heading}</h2>
  <p>{press.text}</p>
</section>

<style>
  .charts-cards {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* A chart reads as a reference: the orange edge of the guides index. */
  .charts-card {
    padding: var(--space-3);
    border-top: var(--tick-weight) solid var(--color-accent);
    background: var(--color-surface);
  }

  .charts-card a {
    font-weight: 600;
  }

  .charts-card p {
    margin: var(--space-1) 0 0;
  }

  .charts-meta {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
</style>
