---
import Layout from './Layout.astro';
import { PRIVACY_TEXTS } from '../privacy.ts';
import type { Lang } from '../routes.ts';

interface Props {
  readonly lang: Lang;
}

const { title, description, h1, lead, sections, reviewed } = PRIVACY_TEXTS[Astro.props.lang];
---

<Layout {title} {description}>
  <main class="pool-page">
    <h1>{h1}</h1>
    <p>{lead}</p>
    {sections.map(({ id, heading, paragraphs }) => (
      <section class="pool-privacy" aria-labelledby={id}>
        <h2 {id}>{heading}</h2>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    ))}
    <p class="pool-privacy-note">{reviewed}</p>
  </main>
</Layout>

<style>
  .pool-privacy {
    display: grid;
    gap: 0.75rem;
  }

  .pool-privacy h2 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
  }

  .pool-page .pool-privacy-note {
    font-size: 0.875rem;
  }
</style>
