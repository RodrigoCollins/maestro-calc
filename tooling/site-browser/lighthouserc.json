{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8787/",
        "http://127.0.0.1:8787/es",
        "http://127.0.0.1:8787/methodology",
        "http://127.0.0.1:8787/es/metodologia",
        "http://127.0.0.1:8787/concrete-calculator",
        "http://127.0.0.1:8787/es/calculadora-de-concreto"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "WRANGLER_SEND_METRICS=false npx wrangler dev --config wrangler.e2e.jsonc --port 8787 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 60000,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
