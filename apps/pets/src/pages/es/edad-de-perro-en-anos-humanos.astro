---
import { dogAge } from '@maestro-calc/pets-core/dog-age';
import CalcPage from '../../components/CalcPage.astro';
import { EDAD_PERRO_ARTICLE, EDAD_PERRO_METHOD, EDAD_PERRO_PAGE } from '../../es/edad-perro.ts';
import { dogAgeViewEs } from '../../es/edad-perro-view.ts';
import EdadPerroScript from '../../islands/EdadPerroScript.astro';
import { hrefOf } from '../../routes.ts';
---

<CalcPage
  page={EDAD_PERRO_PAGE}
  calculator={dogAge}
  view={dogAgeViewEs}
  kind="dog-age"
  method={EDAD_PERRO_METHOD}
  article={EDAD_PERRO_ARTICLE}
  related={[
    {
      href: hrefOf('foods', 'es'),
      label: '¿Qué frutas pueden comer los perros? Todos los alimentos, de tóxico a seguro',
    },
    {
      href: hrefOf('chocolate-guide', 'es'),
      label: '¿Qué pasa si un perro come chocolate? Qué hacer ahora',
    },
    { href: hrefOf('dog-age-chart'), label: 'Dog age chart (en inglés)' },
  ]}
>
  <EdadPerroScript />
</CalcPage>
