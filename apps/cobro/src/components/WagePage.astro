---
import { WAGES_CHECKED } from '../bylines.ts';
import { hrefOf, TRADE_PATHS, wagePathOf, WAGE_STEMS, type Lang, type TradeId } from '../routes.ts';
import { titleOf } from '../seo/meta.ts';
import { TRADE_TEXTS } from '../texts/trades.ts';
import { WAGE_TEXTS } from '../texts/wages.ts';
import { AREAS } from '../wages/areas.ts';
import { stateWageViewOf } from '../wages/view.ts';
import Byline from './Byline.astro';
import Layout from './Layout.astro';
import ShareLink from './ShareLink.astro';

interface Props {
  readonly trade: TradeId;
  readonly fips: string;
  readonly lang: Lang;
}

const { trade, fips, lang } = Astro.props;
const view = stateWageViewOf(trade, fips, lang);
const text = WAGE_TEXTS[lang];
const state = AREAS.find((area) => area.fips === fips)?.name[lang] ?? '';
const index = { path: WAGE_STEMS[trade][lang] };
---

<Layout
  title={titleOf(view.title)}
  description={view.description}
  extras={{ parent: { name: text.crumb, path: index.path }, modified: WAGES_CHECKED }}
>
  <article class="prose">
    <ul class="crumbs">
      <li>
        <a href={hrefOf('wages', lang)}>{text.crumb}</a>
      </li>
      <li>
        <a href={WAGE_STEMS[trade][lang]}>{TRADE_TEXTS[lang][trade].name}</a>
      </li>
      <li>{state}</li>
    </ul>
    <h1>{view.h1}</h1>
    <Byline {lang} checked={WAGES_CHECKED} sourcesId="source" />
    <p class="lead">{view.lead}</p>
    <div class="stats">
      {view.stats.map((stat) => (
        <div>
          <span>{stat.label}</span>
          <p class="big">{stat.value}</p>
        </div>
      ))}
    </div>

    <h2>{view.year.h2}</h2>
    {view.year.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}

    <h2>{view.nation.h2}</h2>
    {view.nation.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}

    <h2>{view.region.h2}</h2>
    <p>{view.region.paragraph}</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label={view.region.caption}>
      <table>
        <caption>{view.region.caption}</caption>
        <thead>
          <tr>
            <th>{text.table.state}</th>
            <th class="num">{text.table.mean}</th>
            <th class="num">{text.table.median}</th>
            <th class="num">{view.region.versus}</th>
          </tr>
        </thead>
        <tbody>
          {view.region.rows.map((row) => (
            <tr>
              <th>
                {row.href === undefined ? (
                  <strong>{row.state}</strong>
                ) : (
                  <a href={row.href}>{row.state}</a>
                )}
              </th>
              <td class="num">{row.mean}</td>
              <td class="num">{row.median}</td>
              <td class="num">{row.href === undefined ? '' : row.versus}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>{view.trades.h2}</h2>
    <p>{view.trades.paragraph}</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label={view.trades.h2}>
      <table>
        <thead>
          <tr>
            <th>{text.tradeColumn}</th>
            <th class="num">{text.table.mean}</th>
            <th class="num">{text.table.median}</th>
            <th class="num">{view.trades.versus}</th>
          </tr>
        </thead>
        <tbody>
          {view.trades.rows.map((row) => (
            <tr>
              <th>
                {row.href === undefined ? (
                  <strong>{row.state}</strong>
                ) : (
                  <a href={row.href}>{row.state}</a>
                )}
              </th>
              <td class="num">{row.mean}</td>
              <td class="num">{row.median}</td>
              <td class="num">{row.href === undefined ? '' : row.versus}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>{view.minimum.h2}</h2>
    {view.minimum.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}

    <section class="card card-gold" aria-labelledby="rate-card">
      <h2 id="rate-card">{view.rateH2}</h2>
      <p>{text.rateBody}</p>
      <p>{view.quote.paragraph}</p>
      <ul>
        <li>
          <a href={view.quote.href}>{view.quote.label}</a>
        </li>
        <li>
          <a href={TRADE_PATHS[trade][lang]}>{text.calculator}</a>
        </li>
        <li>
          <a href={hrefOf('rate-guide', lang)}>{text.guide}</a>
        </li>
      </ul>
    </section>

    <ShareLink {lang} name={view.h1} path={wagePathOf(trade, fips, lang)} />
    <h2 id="source">{text.sourcesH2}</h2>
    <ul class="byline">
      {view.sources.map((source) => (
        <li>
          <a href={source.href} rel="noopener">
            {source.label}
          </a>
        </li>
      ))}
    </ul>
  </article>
</Layout>
