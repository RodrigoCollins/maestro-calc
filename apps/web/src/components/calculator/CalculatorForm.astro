---
import { labelId } from '../../calculator/ids.ts';
import CalculatorField from './CalculatorField.astro';
import type { Choice, FormView } from './model.ts';

interface Props {
  form: FormView;
}
const { unitsLabel, units, items, copyLabel, shareLabel } = Astro.props.form;
const pressed = (choice: Choice): 'true' | 'false' => (choice.pressed ? 'true' : 'false');
---

<form class="calc-form" autocomplete="off" novalidate>
  <div class="calc-group" role="group" aria-labelledby="calc-units-label">
    <span class="calc-legend" id="calc-units-label">
      {unitsLabel}
    </span>
    <div class="calc-segments">
      {units.map((choice) => (
        <button type="button" data-unit={choice.id} aria-pressed={pressed(choice)} disabled>
          {choice.label}
        </button>
      ))}
    </div>
  </div>
  {items.map((item) =>
    item.kind === 'choice' ? (
      <Fragment>
        <div
          class="calc-group"
          role="group"
          aria-labelledby={labelId(item.key)}
          data-choice={item.key}
        >
          <span class="calc-legend" id={labelId(item.key)}>
            {item.label}
          </span>
          <div class="calc-segments">
            {item.choices.map((choice) => (
              <button type="button" value={choice.id} aria-pressed={pressed(choice)} disabled>
                {choice.label}
              </button>
            ))}
          </div>
        </div>
        {item.area !== undefined && (
          <div class="calc-choice-area" style={`--calc-rows:${String(item.area.rows)}`}>
            {item.area.fields.map((field) => (
              <CalculatorField {field} hidden={!field.visible} />
            ))}
          </div>
        )}
      </Fragment>
    ) : (
      <CalculatorField field={item.field} stepper={item.stepper} />
    ),
  )}
  <div class="calc-copy" data-reserved="copy">
    <button type="button" data-copy hidden disabled>
      {copyLabel}
    </button>
    <a
      class="calc-share"
      data-share="https://wa.me/"
      target="_blank"
      rel="noopener noreferrer"
      hidden
    >
      {shareLabel}
    </a>
    <p class="calc-status" data-copy-status role="status"></p>
  </div>
  <slot />
</form>
