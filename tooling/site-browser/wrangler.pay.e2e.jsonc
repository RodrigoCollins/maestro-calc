// apps/pay/wrangler.jsonc without its `build` command: the e2e run serves the `dist` that CI
// already built. `apps/pay/src/deploy.test.ts` keeps the two `assets` blocks equal.
{
  "name": "cuenta-horas",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "../../apps/pay/dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
