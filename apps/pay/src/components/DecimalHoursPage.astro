---
import { decimalHours } from '@maestro-calc/pay-core/decimal-hours';
import { decimalHoursText, hoursMinutesText, hoursText } from '../format.ts';
import { HOME_TEXTS } from '../home/texts.ts';
import { CHART_ROWS } from '../hours/chart.ts';
import { commonLinksOf } from '../long-tail/jobs.ts';
import { DECIMAL_HOURS_PATHS, DECIMAL_HOURS_TEXTS } from '../hours/texts.ts';
import type { Lang } from '../time-card/receipt.ts';
import ShareLink from './ShareLink.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
  readonly lang: Lang;
  /** The embed of the page (`src/embed/embeds.ts`): the same calculator in the slim shell. */
  readonly embed?: boolean;
}

const { lang, embed = false } = Astro.props;
const common = commonLinksOf('minutes', lang);
const t = DECIMAL_HOURS_TEXTS[lang];
// The page renders the engine's own figures for the defaults, so it reads without JavaScript.
const ran = decimalHours.run({});
if (!ran.ok) throw new Error('the defaults of the decimal hours converter must run');
const [decimal, fromDecimal] = ran.value.outputs;
if (decimal?.key !== 'decimalHours' || fromDecimal?.key !== 'fromDecimal') {
  throw new Error('the converter must lead with decimal hours, then the reverse line');
}
const [hoursInput, minutesInput, decimalInput] = decimalHours.inputs;
---

<SiteLayout
  embed={embed}
  lang={lang}
  title={t.title}
  description={t.description}
  paths={DECIMAL_HOURS_PATHS}
  otherLang={t.otherLang}
  footer={HOME_TEXTS[lang].sources}
>
  <main class="page">
    <div>
      <p class="kicker">{t.kicker}</p>
      <h1>{t.h1}</h1>
    </div>
    <p class="lead">{t.lead}</p>

    <form class="deduction" data-decimal-hours novalidate>
      <div class="settings">
        <label class="field">
          {t.hours}
          <input
            name="hours"
            inputmode="numeric"
            autocomplete="off"
            value={String(hoursInput.default)}
          />
        </label>
        <label class="field">
          {t.minutes}
          <input
            name="minutes"
            inputmode="numeric"
            autocomplete="off"
            value={String(minutesInput.default)}
          />
        </label>
      </div>

      <section class="result" aria-live="polite" aria-labelledby="figure-label">
        <div>
          <p class="result-label" id="figure-label">
            {t.figureLabel}
          </p>
          <p class="result-figure" data-out="decimalHours" data-format="decimal">
            {decimalHoursText(decimal.value)}
          </p>
        </div>
      </section>

      <h2 class="reverse-heading">{t.reverseHeading}</h2>
      <label class="field">
        {t.decimal}
        <input
          name="decimal"
          inputmode="decimal"
          autocomplete="off"
          value={hoursText(decimalInput.default)}
        />
      </label>
      <section class="result" aria-live="polite" aria-labelledby="reverse-label">
        <div>
          <p class="result-label" id="reverse-label">
            {t.fromDecimalLabel}
          </p>
          <p class="result-figure" data-out="fromDecimal" data-format="hours-minutes">
            {hoursMinutesText(fromDecimal.value)}
          </p>
        </div>
      </section>

      <ShareLink lang={lang} title={t.title} path={DECIMAL_HOURS_PATHS[lang]} />
    </form>

    <ul class="rules">
      {t.notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>

    <section class="chart" aria-labelledby="chart-heading">
      <h2 id="chart-heading">{t.chartHeading}</h2>
      <p class="note">{t.chartLead}</p>
      <table class="ledger">
        <thead>
          <tr>
            {[0, 1, 2].map(() => (
              <>
                <th scope="col">{t.chartMinutes}</th>
                <th scope="col">{t.chartDecimal}</th>
              </>
            ))}
          </tr>
        </thead>
        <tbody>
          {CHART_ROWS.map((row) => (
            <tr>
              {row.map((entry) => (
                <>
                  <th scope="row">{entry.minutes}</th>
                  <td>{entry.decimal}</td>
                </>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <ul class="link-list">
      {t.links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <section aria-labelledby="common-heading">
      <h2 id="common-heading">{common.heading}</h2>
      <ul class="link-list">
        {common.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <script src="../client/decimal-hours.ts"></script>
</SiteLayout>
