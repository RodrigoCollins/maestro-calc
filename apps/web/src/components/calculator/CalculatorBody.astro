---
import Breadcrumb from './Breadcrumb.astro';
import CalculatorForm from './CalculatorForm.astro';
import ResultPanel from './ResultPanel.astro';
import SourceList from './SourceList.astro';
import type { CalculatorContent, CalculatorPageView } from './model.ts';
import '../../styles/calculator.css';

interface Props {
  view: CalculatorPageView;
  content: CalculatorContent;
  /** An embed (embed) shows no breadcrumb: the frame is not inside the site's hierarchy. */
  embedded?: boolean;
}
const { view, content, embedded = false } = Astro.props;
const { messages } = view;
---

<div class="calculator" data-calculator={view.id}>
  {!embedded && <Breadcrumb breadcrumb={view.breadcrumb} />}
  <h1>{view.title}</h1>
  {view.answer !== undefined && (
    <p class="calc-answer" data-answer data-reserved="answer" aria-live="polite">
      {view.answer}
    </p>
  )}
  <CalculatorForm form={view.form} />
  <div class="calc-side">
    <ResultPanel result={view.result} />
    <div class="calc-copy" data-reserved="copy">
      <button type="button" data-copy hidden disabled>
        {view.form.copyLabel}
      </button>
      <a
        class="calc-share"
        data-share="https://wa.me/"
        target="_blank"
        rel="noopener noreferrer"
        hidden
      >
        {view.form.shareLabel}
      </a>
      <p class="calc-status" data-copy-status role="status"></p>
    </div>
    <div class="calc-notice" data-reserved="notice">
      <p data-not-running>{view.notRunning}</p>
    </div>
  </div>
  <template data-messages>
    {messages.map(([name, text]) => (
      <p id={name}>{text}</p>
    ))}
  </template>
  <div class="calc-content">
    <slot />
    <SourceList {content} />
  </div>
</div>
