---
import { hoursBetween } from '@maestro-calc/pay-core/hours';
import { clockFieldText, decimalHoursText, hoursMinutesText } from '../format.ts';
import { HOME_TEXTS } from '../home/texts.ts';
import { HOURS_PATHS, HOURS_TEXTS } from '../hours/texts.ts';
import { commonLinksOf } from '../long-tail/jobs.ts';
import type { Lang } from '../time-card/receipt.ts';
import ShareLink from './ShareLink.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
  readonly lang: Lang;
  /** The embed of the page (`src/embed/embeds.ts`): the same calculator in the slim shell. */
  readonly embed?: boolean;
}

const { lang, embed = false } = Astro.props;
const t = HOURS_TEXTS[lang];
// The page renders the engine's own figures for the default shift, so it reads without JavaScript.
const ran = hoursBetween.run({});
if (!ran.ok) throw new Error('the default shift of the hours calculator must run');
const [hours, shift] = ran.value.outputs;
if (hours?.key !== 'hours' || shift?.key !== 'shiftHours') {
  throw new Error('the hours calculator must lead with the hours, then the shift');
}
const [startInput, endInput, breakInput] = hoursBetween.inputs;
const warnings = Object.entries(t.warnings);
const common = commonLinksOf('shift', lang);
const days = commonLinksOf('days', lang);
const live = (['time-offset', 'until', 'days-from'] as const).map((family) => ({
  family,
  ...commonLinksOf(family, lang),
}));
const LIVE_INTRO = {
  en: {
    'time-offset':
      'A time some hours ago or some minutes from now is your clock moved by the offset, with the date changing when the count crosses midnight. Each page shows the time from your clock and, for every hour of the day, the time then and whether it falls on the day before.',
    until:
      'How long until a time of day is that time on a 24-hour clock minus the time on yours, plus 24 hours once it has passed. Each page counts it from your clock and from every hour, in hours and minutes and in decimal hours.',
    'days-from':
      'A date some days from today moves the weekday by the days left over after whole weeks; a date some months from today keeps the day of the month, or takes the last day of a shorter month. Each page gives the date from your calendar, the workdays in between and the dates from each month.',
  },
  es: {
    'time-offset':
      'Una hora de hace unas horas o dentro de unos minutos es tu reloj movido por esa cantidad, y la fecha cambia cuando la cuenta cruza la medianoche. Cada página muestra la hora desde tu reloj y, para cada hora del día, la hora de entonces y si cae en el día anterior.',
    until:
      'Lo que falta para una hora del día es esa hora en reloj de 24 horas menos la de tu reloj, más 24 horas si ya pasó. Cada página lo cuenta desde tu reloj y desde cada hora, en horas y minutos y en horas decimales.',
    'days-from':
      'Una fecha a unos días de hoy mueve el día de la semana según los días que sobran después de las semanas enteras; una fecha a unos meses de hoy mantiene el número del día, o toma el último día de un mes más corto. Cada página da la fecha desde tu calendario, los días hábiles en medio y las fechas desde cada mes.',
  },
} as const;
---

<SiteLayout
  embed={embed}
  lang={lang}
  title={t.title}
  description={t.description}
  paths={HOURS_PATHS}
  otherLang={t.otherLang}
  footer={HOME_TEXTS[lang].sources}
>
  <main class="page">
    <div>
      <p class="kicker">{t.kicker}</p>
      <h1>{t.h1}</h1>
    </div>
    <p class="lead">{t.lead}</p>

    <form class="deduction" data-hours novalidate>
      <div class="settings">
        <label class="field">
          {t.start}
          <input name="start" autocomplete="off" value={clockFieldText(startInput.default)} />
        </label>
        <label class="field">
          {t.end}
          <input name="end" autocomplete="off" value={clockFieldText(endInput.default)} />
        </label>
      </div>
      <p class="note">{t.timeHint}</p>
      <label class="field">
        {t.unpaidBreak}
        <input
          name="unpaidBreak"
          inputmode="numeric"
          autocomplete="off"
          value={String(breakInput.default)}
        />
      </label>
    </form>

    {warnings.map(([code, text]) => (
      <p class="warning" data-warning={code} hidden>
        {text}
      </p>
    ))}

    <section class="result" aria-live="polite" aria-labelledby="figure-label">
      <div>
        <p class="result-label" id="figure-label">
          {t.figureLabel}
        </p>
        <p class="result-figure" data-out="hours" data-format="hours-minutes">
          {hoursMinutesText(hours.value)}
        </p>
      </div>
      <ul class="breakdown labeled" aria-label={t.figures}>
        <li>
          <span>{t.decimalLabel}</span>
          <span data-out="hours" data-format="decimal">
            {decimalHoursText(hours.value)}
          </span>
        </li>
        <li>
          <span>{t.shiftLabel}</span>
          <span data-out="shiftHours" data-format="hours-minutes">
            {hoursMinutesText(shift.value)}
          </span>
        </li>
      </ul>
    </section>

    <ShareLink lang={lang} title={t.title} path={HOURS_PATHS[lang]} />

    <ul class="rules">
      {t.notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>
    <ul class="link-list">
      {t.links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <section aria-labelledby="common-heading">
      <h2 id="common-heading">{common.heading}</h2>
      <ul class="link-list">
        {common.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="days-heading">
      <h2 id="days-heading">{days.heading}</h2>
      <ul class="link-list">
        {days.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>

    {live.map(({ family, heading, links }) => (
      <section aria-labelledby={`${family}-heading`}>
        <h2 id={`${family}-heading`}>{heading}</h2>
        <p>{LIVE_INTRO[lang][family]}</p>
        <ul class="link-list">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
  <script src="../client/hours.ts"></script>
</SiteLayout>
