---
import { SITE } from '../site.config.ts';

interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="wordmark" {href}>
  {SITE.name}
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
</style>
