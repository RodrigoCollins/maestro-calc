---
import { dogFood } from '@maestro-calc/pets-core/dog-food';
import { dogView, PUPPY_PAGE } from '../calc/dog.ts';
import CalcPage from '../components/CalcPage.astro';
import DogScript from '../islands/DogScript.astro';
import { hrefOf } from '../routes.ts';
---

<CalcPage
  page={PUPPY_PAGE}
  calculator={dogFood}
  view={dogView}
  kind="dog"
  method="A puppy needs 3.0 times its resting calories (70 × kg^0.75) under 4 months and 2.0 times from 4 months, in both the Merck Veterinary Manual and the 2021 AAHA guidelines."
  related={[
    { href: hrefOf('puppy-chart'), label: 'Puppy feeding chart by weight' },
    { href: hrefOf('puppy-weight'), label: 'How big will my puppy get? Puppy weight calculator' },
    { href: hrefOf('dog'), label: 'Dog food calculator for adults' },
    { href: hrefOf('label-guide'), label: 'How to read a pet food label' },
    { href: hrefOf('due-date'), label: 'Dog pregnancy calculator' },
  ]}
>
  <DogScript />
</CalcPage>
