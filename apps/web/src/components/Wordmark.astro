---
import { SITE } from '../site.config.ts';

interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="wordmark tap-target" {href}>
  {SITE.name}
</a>

<style is:global>
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }
</style>
