---
import { CALL_NOW, POISON_LINE } from '../calc/chocolate.ts';
import { guideOf } from '../guides.ts';
import { ROUTES } from '../routes.ts';
import Byline from './Byline.astro';
import Layout from './Layout.astro';
import ShareLink from './ShareLink.astro';
import Sources from './Sources.astro';

interface Props {
  readonly path: string;
}

const guide = guideOf(Astro.props.path);
const { title, description, h1, lead, checked, sections, calculators, sources, table, questions } =
  guide;
const LABELS: Readonly<Record<string, string>> = {
  dog: 'Dog food calculator',
  cat: 'Cat food calculator',
  puppy: 'Puppy feeding calculator',
  kitten: 'Kitten feeding calculator',
  chocolate: 'Dog chocolate toxicity calculator',
  'due-date': 'Dog pregnancy due date calculator',
  'cat-age': 'Cat age calculator',
};
const tools = calculators.flatMap((path) => ROUTES.filter((route) => route.path === path));
---

<Layout {title} {description} modified={checked}>
  <main class="bf-page">
    <h1>{h1}</h1>
    <Byline {checked} />
    <p>{lead}</p>
    {guide.callNow === true && (
      <p class="bf-call" role="note">
        {CALL_NOW} <a href={POISON_LINE.href}>{POISON_LINE.phone}</a>
      </p>
    )}
    {sections.map(({ id, heading, paragraphs }) => (
      <>
        <section aria-labelledby={id}>
          <h2 {id}>{heading}</h2>
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
        {table !== undefined && table.after === id && (
          <section aria-labelledby={table.id}>
            <h2 id={table.id}>{table.heading}</h2>
            {table.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <div
              class="bf-scroll"
              tabindex="0"
              role="region"
              aria-label={`${table.heading}, scrolls sideways on a narrow screen`}
            >
              <table class="bf-table">
                <thead>
                  <tr>
                    {table.columns.map((column) => (
                      <th scope="col">{column}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {table.rows.map(([first, ...cells]) => (
                    <tr>
                      <th scope="row">{first}</th>
                      {cells.map((cell) => (
                        <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p>{table.linksHeading}</p>
            <ul>
              {table.links.map(({ href, label }) => (
                <li>
                  <a {href}>{label}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    ))}
    {questions !== undefined && (
      <section aria-labelledby="faq">
        <h2 id="faq">Frequently asked questions</h2>
        {questions.map(({ question, answer }) => (
          <>
            <h3>{question}</h3>
            <p>{answer}</p>
          </>
        ))}
      </section>
    )}
    <section class="bf-card mint" aria-labelledby="bf-tools">
      <h2 id="bf-tools">Calculators</h2>
      <ul>
        {tools.map(({ id, path }) => (
          <li>
            <a href={path}>{LABELS[id]}</a>
          </li>
        ))}
      </ul>
    </section>
    <Sources {sources} />
    <ShareLink path={guide.path} {title} />
  </main>
</Layout>
