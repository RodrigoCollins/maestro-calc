---
import { calculatorsOf, guideAt } from '../guide.ts';
import { hrefOf } from '../routes.ts';
import { childTrailOf, pageTrailOf } from '../seo/breadcrumb.ts';
import Byline from './Byline.astro';
import Layout from './Layout.astro';
import Sources from './Sources.astro';

interface Props {
  readonly path: string;
}

const guide = guideAt(Astro.props.path);
const calculators = calculatorsOf(guide);
const trail = guide.parent === undefined ? pageTrailOf(guide) : childTrailOf(guide, guide.parent);
---

<Layout title={guide.title} description={guide.description} {trail} modified={guide.checked}>
  <Fragment slot="hero">
    <section class="lawn-hero">
      <h1>{guide.h1}</h1>
      <Byline path={guide.path} />
      <p>{guide.lead}</p>
    </section>
  </Fragment>
  <main class="lawn-main">
    {guide.sections.map(({ id, heading, paragraphs, items, table, links }) => (
      <section class="lawn-section" aria-labelledby={id}>
        <h2 {id}>{heading}</h2>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {items !== undefined && (
          <ul>
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
        {table !== undefined && (
          <div class="lawn-guide-table" role="region" aria-labelledby={`${id}-table`} tabindex="0">
            <table>
              <caption id={`${id}-table`}>{table.caption}</caption>
              <thead>
                <tr>
                  {table.head.map((cell) => (
                    <th scope="col">{cell}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {table.rows.map(([first, ...cells]) => (
                  <tr>
                    <th scope="row">{first}</th>
                    {cells.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {links !== undefined && (
          <ul>
            {links.map(({ href, label }) => (
              <li>
                <a {href}>{label}</a>
              </li>
            ))}
          </ul>
        )}
        {id === 'frost' && (
          <p>
            <a href={hrefOf('frost-index')}>Find your frost dates</a>
          </p>
        )}
        {id === 'amounts' && (
          <ul>
            {calculators.map(({ path, h1 }) => (
              <li>
                <a href={path}>{h1}</a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
    <section class="lawn-section" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {guide.questions.map(({ question, answer }) => (
        <div class="lawn-qa">
          <h3>{question}</h3>
          <p>{answer}</p>
        </div>
      ))}
    </section>
    <Sources path={guide.path} />
  </main>
</Layout>

<style is:global>
  .lawn-qa {
    display: grid;
    gap: 0.25rem;
  }

  .lawn-guide-table {
    overflow-x: auto;
    border-radius: 0.75rem;
    background: var(--card);
  }

  .lawn-guide-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .lawn-guide-table caption {
    padding: 0.5rem;
    text-align: left;
  }

  .lawn-guide-table th,
  .lawn-guide-table td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .lawn-guide-table thead th {
    background: var(--deep);
    color: var(--on-stripe);
  }

  .lawn-guide-table tbody th {
    font-weight: 600;
    min-width: 7rem;
  }

  .lawn-qa h3 {
    margin: 0;
    font-size: 1.0625rem;
  }
</style>
