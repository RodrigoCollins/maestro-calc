---
import { linkPreviewOf } from '../seo/head.ts';
import { SITE } from '../site.config.ts';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  alternates?: readonly { hreflang: string; href: string }[];
  robots?: string;
  /** A serialized JSON-LD document (see `serializeJsonLd`), written verbatim into a data block. */
  jsonLd?: string;
  /** The Open Graph locale of the page (`en_US`) and of its other languages. */
  ogLocale?: string;
  ogAlternateLocales?: readonly string[];
  /** The Open Graph type: `article` for a guide, `website` for every other page. */
  ogType?: 'website' | 'article';
}
const {
  title,
  description,
  canonical,
  alternates = [],
  robots,
  jsonLd,
  ogLocale,
  ogAlternateLocales = [],
  ogType = 'website',
} = Astro.props;
// open-graph: an indexable page (it has a canonical) is shared with its title, description,
// address and the one language-free image; the not-found page has none.
const og = canonical !== undefined && ogLocale !== undefined;
const preview = linkPreviewOf({ title, description });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{robots !== undefined && <meta name="robots" content={robots} />}
{canonical !== undefined && <link rel="canonical" href={canonical} />}
{alternates.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}
{og && (
  <Fragment>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={preview['og:title']} />
    <meta property="og:description" content={preview['og:description']} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternateLocales.map((locale) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    <meta property="og:image" content={preview['og:image']} />
    <meta property="og:image:width" content={preview['og:image:width']} />
    <meta property="og:image:height" content={preview['og:image:height']} />
    <meta property="og:image:alt" content={SITE.name} />
    <meta name="twitter:card" content={preview['twitter:card']} />
  </Fragment>
)}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
{jsonLd !== undefined && <script is:inline type="application/ld+json" set:html={jsonLd} />}
