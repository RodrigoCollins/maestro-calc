---
interface Props {
  contactLabel: string;
  email: string;
  links: readonly { href: string; label: string }[];
}
const { contactLabel, email, links } = Astro.props;
---

<footer class="site-footer">
  <p>
    {contactLabel}{' '}
    <a class="footer-link tap-target" href={`mailto:${email}`}>
      {email}
    </a>
  </p>
  {links.length > 0 && (
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a class="footer-link tap-target" {href}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  )}
</footer>

<style>
  .site-footer {
    max-width: var(--page-width);
    margin: var(--space-5) auto 0;
    padding: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
