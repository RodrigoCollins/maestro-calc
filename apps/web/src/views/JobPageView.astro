---
import type { Locale } from '@maestro-calc/i18n';
import Breadcrumb from '../components/calculator/Breadcrumb.astro';
import Byline from '../components/Byline.astro';
import GuideCta from '../components/GuideCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { jobCoverings, jobGuide } from '../lib/job-guide.ts';
import { jobLand } from '../lib/job-land.ts';
import { jobQuestion } from '../lib/job-question.ts';
import { jobSlope } from '../lib/job-slope.ts';
import { jobConcrete } from '../lib/job-concrete.ts';
import { jobFloor } from '../lib/job-floor.ts';
import { jobRafter } from '../lib/job-rafter.ts';
import { jobRoof } from '../lib/job-roof.ts';
import { jobSoil } from '../lib/job-soil.ts';
import { jobRoom } from '../lib/job-room.ts';
import { jobView } from '../lib/job-view.ts';
import { jobWorked } from '../lib/job-worked.ts';
import { bylineOf, calculatorSourcesHref, CHART_SOURCES_ID } from '../lib/byline.ts';
import { calendarDay } from '../lib/calendar-day.ts';
import { siteText } from '../lib/site-text.ts';
import { JOBS, type JobId } from '../routing/jobs.ts';
import { pathOf } from '../routing/routes.ts';
import { headFor } from '../seo/head.ts';
import { jobJsonLd, serializeJsonLd, type JobPage } from '../seo/json-ld.ts';
import { getEntry } from 'astro:content';
import { headingOf } from '../content/heading.ts';
import { hubOfCalculator } from '../routing/hubs.ts';

/*
 * A job page (growth plan, lever 1): the answer for one common job and its table, every figure
 * worked out at build time by the engine the calculator runs, each size linked to the calculator
 * with that size filled in. No script.
 */
interface Props {
  id: JobId;
  locale: Locale;
}
const { id, locale } = Astro.props;
const text = siteText(locale);
const view = jobView(id, locale);
const { chart } = view;
const { updated, calculator } = JOBS[id];
// Signed by the editorial team on the day its row was checked: a chart points at its own sources,
// any other job at the sources of its calculator.
const byline = bylineOf(
  locale,
  updated,
  chart === undefined ? calculatorSourcesHref(calculator, locale) : `#${CHART_SOURCES_ID}`,
);
// The trail the page sits on, each page named by its h1: its calculator's hub, then the calculator.
const hub = hubOfCalculator(calculator);
if (hub === undefined) throw new Error(`the calculator of job ${id} has no hub`);
const hubEntry = await getEntry('pages', `${locale}/${hub}`);
if (hubEntry === undefined) throw new Error(`no content entry for ${locale}/${hub}`);
const trail = [
  { id: hub, name: headingOf(hubEntry.body ?? '') },
  { id: calculator, name: view.calculatorName },
];
const breadcrumb = {
  label: text('site.calculator.breadcrumb'),
  homeLabel: text('site.calculator.breadcrumbHome'),
  homeHref: pathOf('home', locale),
  trail: trail.map((crumb) => ({ href: pathOf(crumb.id, locale), label: crumb.name })),
  current: view.heading,
};
// One source is named by its address, several by the list of them.
const basedOnOf = ([first, ...rest]: NonNullable<typeof chart>['sources']) => {
  const [second, ...more] = rest;
  return second === undefined
    ? first.source.url
    : ([first.source.url, second.source.url, ...more.map(({ source }) => source.url)] as const);
};
// A reference chart is also a dataset: its description, its day and the data sheet it rests on.
const page: JobPage =
  chart === undefined
    ? { id, name: view.heading, trail }
    : {
        id,
        name: view.heading,
        trail,
        dataset: {
          description: text(`page.${id}.description`),
          updated,
          basedOn: basedOnOf(chart.sources),
        },
      };
const jsonLd = serializeJsonLd(jobJsonLd(page, locale));
// The buying advice of a job of one size, named by the h1 of the guide it links, and for a roof
// pitch the IRC check of every covering at that pitch.
const guide = jobGuide(id, locale);
const coverings = jobCoverings(id, locale);
const worked = jobWorked(id, locale);
// An acre page also says what an acre is by law, the shapes of its lot, what it holds and covers.
const land = jobLand(id, locale);
// An exact pitch page also says how OSHA classes the pitch, the ridge of a gable and the roof surface.
const slope = jobSlope(id, locale);
// A room, a floor, a slab, a tube, a footing, a soil area, a roof or a pitch page also works its
// own size out: surface by surface, what fits on it, its base and weight, its edges, its square.
const extra =
  jobRoom(id, locale) ??
  jobFloor(id, locale) ??
  jobConcrete(id, locale) ??
  jobSoil(id, locale) ??
  jobRoof(id, locale) ??
  jobRafter(id, locale);
// A question page also explains its answer and adds the conversion tables of its question.
const question = jobQuestion(id, locale);
const guideEntry =
  guide === undefined ? undefined : await getEntry('pages', `${locale}/${guide.read}`);
if (guide !== undefined && guideEntry === undefined) {
  throw new Error(`no content entry for ${locale}/${guide.read}`);
}
const guideName = guideEntry === undefined ? '' : headingOf(guideEntry.body ?? '');
---

<BaseLayout {locale} {id} head={{ ...headFor(id, locale, text), jsonLd }}>
  <Breadcrumb {breadcrumb} />
  <article class="prose">
    <h1>{view.heading}</h1>
    <Byline {byline} />
    <p>{view.intro}</p>
    {chart === undefined && (
      <>
        <p class="job-size">{view.lead}</p>
        <p class="job-answer">{view.answer}</p>
        <dl class="job-facts">
          {view.facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </>
    )}
    <p>
      {view.note} <a href={view.methodology}>{text('site.job.methodology')}</a>
    </p>
    {worked !== undefined && (
      <>
        <h2>{worked.heading}</h2>
        <ol>
          {worked.steps.map((step) => (
            <li>
              {step.label}: <span class="job-math">{step.math}</span>
            </li>
          ))}
        </ol>
      </>
    )}
    <h2>{chart === undefined ? text('site.job.cases') : chart.table}</h2>
    <div class="job-table">
      <table>
        <thead>
          <tr>
            {view.columns.map((label) => (
              <th scope="col">{label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {view.rows.map((row) => (
            <tr>
              <th scope="row">
                {row.href === undefined ? row.label : <a href={row.href}>{row.label}</a>}
              </th>
              {row.cells.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {chart?.reverse !== undefined && (
      <>
        <h2>{chart.reverse.heading}</h2>
        <p>{chart.reverse.lead}</p>
        <div class="job-table">
          <table>
            <thead>
              <tr>
                {chart.reverse.columns.map((label) => (
                  <th scope="col">{label}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {chart.reverse.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    {chart !== undefined && (
      <>
        <h2 id={CHART_SOURCES_ID}>{text('site.job.chart.sources')}</h2>
        {chart.sources.length === 1 ? (
          chart.sources.map(({ label, source }) => (
            <p>
              {label}: {source.name}, <code>{source.url}</code>, {text('site.job.chart.retrieved')}{' '}
              {calendarDay(source.retrieved, locale)}.
            </p>
          ))
        ) : (
          <ul>
            {chart.sources.map(({ label, source }) => (
              <li>
                {label}: {source.name}, <code>{source.url}</code>,{' '}
                {text('site.job.chart.retrieved')} {calendarDay(source.retrieved, locale)}.
              </li>
            ))}
          </ul>
        )}
        <h3>{chart.basis}</h3>
        <dl class="job-facts">
          {chart.facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <h2>{text('site.job.chart.cite')}</h2>
        <p>{text('site.job.chart.citeLead')}</p>
        <p class="job-cite">{chart.citation}</p>
        <p>
          <a href={pathOf('charts', locale)}>{text('site.job.chart.index')}</a>
        </p>
      </>
    )}
    {land !== undefined && (
      <>
        <h2>{land.heading}</h2>
        <p>{land.definition}</p>
        <p>{land.surveyFoot}</p>
        <p>
          {land.sourceLabel}: {land.source.name}, <code>{land.source.url}</code>,{' '}
          {text('site.job.chart.retrieved')} {calendarDay(land.source.retrieved, locale)}.
        </p>
        <h2>{land.shape.heading}</h2>
        {land.shape.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <h2>{land.glance.heading}</h2>
        <dl class="job-facts">
          {land.glance.facts.map(({ label, value, href }) => (
            <div>
              <dt>{href === undefined ? label : <a {href}>{label}</a>}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <h2>{land.cover.heading}</h2>
        <p>{land.cover.lead}</p>
        <div class="job-table">
          <table>
            <thead>
              <tr>
                {land.cover.columns.map((label) => (
                  <th scope="col">{label}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {land.cover.rows.map((row) => (
                <tr>
                  <th scope="row">
                    <a href={row.href}>{row.label}</a>
                  </th>
                  {row.cells.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    {coverings !== undefined && (
      <>
        <h2>{coverings.heading}</h2>
        <p>{coverings.lead}</p>
        <div class="job-table">
          <table>
            <thead>
              <tr>
                {coverings.columns.map((label) => (
                  <th scope="col">{label}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {coverings.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{row.minimum}</td>
                  <td>{row.status}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    {slope !== undefined && (
      <>
        <h2>{slope.heading}</h2>
        <p>{slope.osha}</p>
        <p>{slope.note}</p>
        <p>
          {slope.sourceLabel}:{' '}
          {slope.sources.map((source, index) => (
            <>
              {index > 0 && '; '}
              {source.name}, <code>{source.url}</code>, {text('site.job.chart.retrieved')}{' '}
              {calendarDay(source.retrieved, locale)}
            </>
          ))}
          .
        </p>
        <h2>{slope.ridge.heading}</h2>
        <dl class="job-facts">
          {slope.ridge.facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <h2>{slope.area.heading}</h2>
        <p>{slope.area.lead}</p>
        <div class="job-table">
          <table>
            <thead>
              <tr>
                {slope.area.columns.map((label) => (
                  <th scope="col">{label}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {slope.area.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          {slope.area.more} <a href={slope.area.href}>{slope.area.calculator}</a>.
        </p>
      </>
    )}
    {extra !== undefined && (
      <>
        <h2>{extra.heading}</h2>
        {extra.paragraphs.slice(0, 1).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <dl class="job-facts">
          {extra.facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        {extra.table !== undefined && (
          // a table wider than a phone scrolls: the region takes the keyboard focus to scroll it
          <div class="job-table" tabindex="0" role="region" aria-label={extra.heading}>
            <table>
              <thead>
                <tr>
                  {extra.table.columns.map((label) => (
                    <th scope="col">{label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {extra.table.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {row.cells.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {extra.paragraphs.slice(1).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {extra.sources.length > 0 && (
          <p>
            {text('site.job.slope.sources')}:{' '}
            {extra.sources.map((source, index) => (
              <>
                {index > 0 && '; '}
                {source.name}, <code>{source.url}</code>, {text('site.job.chart.retrieved')}{' '}
                {calendarDay(source.retrieved, locale)}
              </>
            ))}
            .
          </p>
        )}
      </>
    )}
    {question !== undefined && (
      <>
        <h2>{question.heading}</h2>
        {question.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {question.tables.map((each) => (
          <>
            <h2>{each.heading}</h2>
            <p>{each.lead}</p>
            <div class="job-table">
              <table>
                <thead>
                  <tr>
                    {each.columns.map((label) => (
                      <th scope="col">{label}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {each.rows.map((row) => (
                    <tr>
                      <th scope="row">
                        {row.href === undefined ? row.label : <a href={row.href}>{row.label}</a>}
                      </th>
                      {row.cells.map((cell) => (
                        <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ))}
        <p>
          {question.sourceLabel}:{' '}
          {question.sources.map(({ label, source }, index) => (
            <>
              {index > 0 && '; '}
              {label}: {source.name}, <code>{source.url}</code>, {text('site.job.chart.retrieved')}{' '}
              {calendarDay(source.retrieved, locale)}
            </>
          ))}
          .
        </p>
        <p>
          {question.more.lead}: <a href={question.more.href}>{question.more.name}</a>.
        </p>
      </>
    )}
    {guide !== undefined && (
      <>
        <h2>{guide.heading}</h2>
        <ul>
          {guide.tips.map((tip) => (
            <li>{tip}</li>
          ))}
        </ul>
        <p>
          {text('site.job.guide.read')} <a href={pathOf(guide.read, locale)}>{guideName}</a>
        </p>
      </>
    )}
    <GuideCta label={text('site.guide.cta')} href={view.cta} name={view.calculatorName} />
    {view.others.length > 0 && (
      <>
        <h2>{text('site.job.more')}</h2>
        <ul>
          {view.others.map(({ href, title }) => (
            <li>
              <a {href}>{title}</a>
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .job-size {
    margin-bottom: 0;
    color: var(--color-text-secondary);
  }

  .job-answer {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 700;
  }

  .job-facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--color-line);
  }

  .job-facts dd {
    margin: 0;
    font-weight: 700;
  }

  .job-math {
    font-variant-numeric: tabular-nums;
  }

  .job-cite {
    padding: var(--space-2);
    border-left: 3px solid var(--color-line);
    overflow-wrap: anywhere;
  }

  /* A phone scrolls the table, never the page. */
  .job-table {
    overflow-x: auto;
  }

  .job-table table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .job-table th,
  .job-table td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-line);
    text-align: right;
  }

  .job-table th:first-child {
    text-align: left;
  }
</style>
