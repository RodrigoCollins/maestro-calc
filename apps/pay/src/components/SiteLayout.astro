---
import { Font } from 'astro:assets';
import type { Lang } from '../time-card/receipt.ts';
import { ROUTES } from '../routes.ts';
import { headOf } from '../seo/head.ts';
import { jsonLdOf } from '../seo/json-ld.ts';
import { SITE } from '../site.config.ts';
import '../styles/site.css';

interface Props {
  readonly lang: Lang;
  readonly title: string;
  readonly description: string;
  /**
   * This page's path in each language; the English one is also the x-default. A page without
   * paths (the 404) has no canonical or alternates, is never indexed and links the other home.
   */
  readonly paths?: Readonly<Record<Lang, string>>;
  readonly otherLang: string;
  readonly footer: string;
  readonly wide?: boolean;
}

const { lang, title, description, paths, otherLang, footer, wide = false } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
const otherHref = paths?.[other] ?? (other === 'en' ? '/' : '/es');
const { canonical, robots, preview } = headOf(paths, lang, { title, description });
const route = paths === undefined ? undefined : ROUTES.find(({ en }) => en === paths.en);
const jsonLd =
  route === undefined ? undefined : jsonLdOf(route, lang, { title, description }, SITE.origin);
const href = (path: string): string => new URL(path, SITE.origin).href;
const method =
  lang === 'en'
    ? { href: '/methodology', label: 'How we calculate' }
    : { href: '/es/metodologia', label: 'Cómo calculamos' };
const privacy =
  lang === 'en'
    ? { href: '/privacy', label: 'Privacy' }
    : { href: '/es/privacidad', label: 'Privacidad' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robots !== undefined && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={preview['og:title']} />
    <meta property="og:description" content={preview['og:description']} />
    {canonical !== undefined && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_US'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_US' : 'en_US'} />
    <meta property="og:image" content={preview['og:image']} />
    <meta property="og:image:width" content={preview['og:image:width']} />
    <meta property="og:image:height" content={preview['og:image:height']} />
    <meta name="twitter:card" content={preview['twitter:card']} />
    {jsonLd !== undefined && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    {paths !== undefined && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en-US" href={href(paths.en)} />
        <link rel="alternate" hreflang="es-US" href={href(paths.es)} />
        <link rel="alternate" hreflang="x-default" href={href(paths.en)} />
      </>
    )}
    <Font cssVariable="--font-body" preload={[{ weight: '800' }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: '400' }]} />
    {SITE.gaId !== '' && (
      <script
        is:inline
        src="/analytics.js"
        data-ga={SITE.gaId}
        data-host={new URL(SITE.origin).hostname}
        defer
      />
    )}
  </head>
  <body class:list={{ wide }}>
    <header class="site-header">
      <div>
        <a class="brand" href={lang === 'en' ? '/' : '/es'}>
          <svg
            width="26"
            height="26"
            viewBox="0 0 26 26"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <rect x="4" y="2" width="18" height="22" rx="2"></rect>
            <path d="M8 7h10M8 11h10M8 15h6"></path>
            <circle cx="18" cy="19" r="2.2" fill="#e0a23b" stroke="none"></circle>
          </svg>
          {SITE.name}
        </a>
        <a class="lang" href={otherHref} hreflang={other} lang={other}>
          {otherLang}
        </a>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <span>{SITE.name}</span>
        <span>{footer}</span>
        <a href={method.href}>{method.label}</a>
        <a href={privacy.href}>{privacy.label}</a>
      </div>
    </footer>
  </body>
</html>
