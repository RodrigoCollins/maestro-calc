---
import ShoppingLine from './ShoppingLine.astro';
import type { ResultView } from './model.ts';

interface Props {
  result: ResultView;
}
const { heading, primary, rows, shopping, costs, costsNote, estimateNote, termsLabel, termsHref } =
  Astro.props.result;
---

<section class="calc-result" aria-labelledby="calc-result-heading">
  <h2 id="calc-result-heading">{heading}</h2>
  <p class="calc-primary">
    {primary.prefixed && <span data-primary-before>{primary.before}</span>}
    <span class="calc-figure" data-primary={primary.key}>
      {primary.value}
    </span>
    <span data-primary-after>{primary.after}</span>
  </p>
  <dl class="calc-rows">
    {rows.map(({ key, label, value, hidden }) => (
      <div class="calc-row" hidden={hidden === true}>
        <dt>{label}</dt>
        <dd class="calc-figure" data-output={key}>
          {value}
        </dd>
      </div>
    ))}
  </dl>
  {shopping.map((line, index) => (
    <ShoppingLine {line} {index} />
  ))}
  {costs.map(({ key, label, value, visible, hint }) => (
    <Fragment>
      <p class="calc-cost" data-cost-row={key} hidden={!visible}>
        <span class="calc-label">{label}</span>
        <span class="calc-figure" data-output={key}>
          {value}
        </span>
      </p>
      <p class="calc-hint" data-hint-row={key} hidden={visible}>
        <span class="calc-label">{label}</span>
        <span data-price-hint={key}>{hint}</span>
      </p>
    </Fragment>
  ))}
  {costsNote !== undefined && <p class="calc-note">{costsNote}</p>}
  <p class="calc-note">
    {estimateNote} <a href={termsHref}>{termsLabel}</a>
  </p>
</section>
