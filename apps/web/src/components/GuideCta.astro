---
/** The end of a guide (guides): one link to the calculator the guide is about, under a short label. */
interface Props {
  label: string;
  href: string;
  name: string;
}
const { label, href, name } = Astro.props;
---

<aside class="guide-cta" aria-label={label}>
  <p>{label}</p>
  <a class="guide-cta-link tap-target" {href}>
    {name}
  </a>
</aside>

<style>
  /* An ink card with a safety-orange edge: the one step the guide leads to, as a button-sized link. */
  .guide-cta {
    margin-block: var(--space-5) var(--space-4);
    padding: var(--space-4) var(--space-3);
    border-left: 6px solid var(--color-accent);
    border-radius: 4px;
    background: var(--color-text);
    color: var(--color-ground);
  }

  .guide-cta p {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.2;
  }

  .guide-cta-link {
    padding: var(--space-2) var(--space-3);
    border-radius: 4px;
    background: var(--color-accent);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .guide-cta-link::after {
    content: '\00a0→' / '';
  }

  .guide-cta-link:hover {
    text-decoration: underline;
  }
</style>
