---
import { calculatorWorkedOf } from '../calculator-worked.ts';

/** The worked example of a calculator page, under its notes: the figures it opens on, by hand. */
interface Props {
  readonly path: string;
}

const { heading, steps, next } = calculatorWorkedOf(Astro.props.path);
---

<section class="pool-worked" aria-labelledby="worked-heading">
  <h2 id="worked-heading">{heading}</h2>
  <ol>
    {steps.map((step) => (
      <li>{step}</li>
    ))}
  </ol>
</section>
<section class="pool-worked" aria-labelledby="next-heading">
  <h2 id="next-heading">{next.heading}</h2>
  <ul>
    {next.items.map(({ text, link }) => (
      <li>
        {text} <a href={link.href}>{link.label}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .pool-worked h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
  }

  .pool-worked ol,
  .pool-worked ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.5;
  }

  /* Each link stands at least 24 px tall with its padding (WCAG 2.5.8, target size). */
  .pool-worked a {
    display: inline-block;
    padding-block: 0.25rem;
  }
</style>
