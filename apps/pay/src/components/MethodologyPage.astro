---
import { decimalHoursText, hoursMinutesText, hoursText, moneyText } from '../format.ts';
import { HOME_TEXTS } from '../home/texts.ts';
import {
  EXAMPLES,
  figuresOf,
  HOURS_EXAMPLES,
  hoursOf,
  OVERTIME_EXAMPLES,
  overtimeFiguresOf,
  type Figures,
} from '../methodology/examples.ts';
import { METHODOLOGY_TEXTS } from '../methodology/texts.ts';
import type { Lang } from '../time-card/receipt.ts';
import { TIME_CARD_TEXTS } from '../time-card/texts.ts';
import SiteLayout from './SiteLayout.astro';

interface Props {
  readonly lang: Lang;
}

const { lang } = Astro.props;
const t = METHODOLOGY_TEXTS[lang];
// The rows are the engine's own figures for each example (examples.test.ts pins them).
const rowOf = (label: string, figures: Figures) => ({
  label,
  regular: hoursText(figures.regularHours),
  overtime: hoursText(figures.overtimeHours),
  double: hoursText(figures.doubleHours),
  pay: moneyText(figures.pay),
});
const groups = [
  {
    id: 'examples',
    heading: t.examplesHeading,
    lead: t.examplesLead,
    rows: EXAMPLES.map((example) => rowOf(t.examples[example.id], figuresOf(example))),
  },
  {
    id: 'overtime-examples',
    heading: t.overtimeExamplesHeading,
    lead: t.overtimeExamplesLead,
    rows: OVERTIME_EXAMPLES.map((example) =>
      rowOf(t.overtimeExamples[example.id], overtimeFiguresOf(example)),
    ),
  },
];
const hoursRows = HOURS_EXAMPLES.map((example) => {
  const hours = hoursOf(example);
  return {
    label: t.hoursExamples[example.id],
    hoursMinutes: hoursMinutesText(hours),
    decimal: decimalHoursText(hours),
  };
});
---

<SiteLayout
  lang={lang}
  title={t.title}
  description={t.description}
  paths={{ en: '/methodology', es: '/es/metodologia' }}
  otherLang={TIME_CARD_TEXTS[lang].otherLang}
  footer={HOME_TEXTS[lang].sources}
>
  <main class="page prose">
    <div>
      <p class="kicker">{t.kicker}</p>
      <h1>{t.h1}</h1>
    </div>
    <p class="lead">{t.lead}</p>

    {t.sections.map((section) => (
      <section aria-labelledby={section.id}>
        <h2 id={section.id}>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {section.sources.length > 0 && (
          <p class="sources">
            {t.sourcesLabel}:{' '}
            {section.sources.map((source, index) => (
              <>
                {index > 0 && '; '}
                <a href={source.href} rel="noopener">
                  {source.label}
                </a>
              </>
            ))}
          </p>
        )}
      </section>
    ))}

    {groups.map((group) => (
      <section aria-labelledby={group.id}>
        <h2 id={group.id}>{group.heading}</h2>
        <p>{group.lead}</p>
        <ul class="examples">
          {group.rows.map((row) => (
            <li>
              <p class="example-label">{row.label}</p>
              <dl>
                <div>
                  <dt>{t.columns.regular}</dt>
                  <dd>{row.regular}</dd>
                </div>
                <div>
                  <dt>{t.columns.overtime}</dt>
                  <dd>{row.overtime}</dd>
                </div>
                <div>
                  <dt>{t.columns.double}</dt>
                  <dd>{row.double}</dd>
                </div>
                <div class="example-pay">
                  <dt>{t.columns.pay}</dt>
                  <dd>{row.pay}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section aria-labelledby="hours-examples">
      <h2 id="hours-examples">{t.hoursExamplesHeading}</h2>
      <p>{t.hoursExamplesLead}</p>
      <ul class="examples">
        {hoursRows.map((row) => (
          <li>
            <p class="example-label">{row.label}</p>
            <dl>
              <div>
                <dt>{t.hoursColumns.hoursMinutes}</dt>
                <dd>{row.hoursMinutes}</dd>
              </div>
              <div class="example-pay">
                <dt>{t.hoursColumns.decimal}</dt>
                <dd>{row.decimal}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </section>

    <p class="note">{t.reviewed}</p>
    <div class="actions">
      <a class="button button-primary" href={t.cta.href}>
        {t.cta.label}
      </a>
      <a class="button button-secondary" href={t.overtimeCta.href}>
        {t.overtimeCta.label}
      </a>
    </div>
  </main>
</SiteLayout>
