---
import type { Locale } from '@maestro-calc/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeCards } from '../lib/home-directory.ts';
import { siteText } from '../lib/site-text.ts';
import { pathOf } from '../routing/routes.ts';
import { headFor } from '../seo/head.ts';
import { homeJsonLd, serializeJsonLd } from '../seo/json-ld.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = siteText(locale);
const cards = homeCards(locale);
---

<BaseLayout
  {locale}
  id="home"
  head={{ ...headFor('home', locale, text), jsonLd: serializeJsonLd(homeJsonLd(locale)) }}
>
  <div class="home-hero">
    <h1>{text('page.home.heading')}</h1>
    <p>{text('page.home.intro')}</p>
  </div>
  <ul class="home-cards" role="list">
    {cards.map((card) => (
      <li class="home-card">
        <h2>
          <a class="tap-target" href={card.href}>
            {card.title}
          </a>
        </h2>
        <p>{card.summary}</p>
        <p class="home-example">{card.example}</p>
      </li>
    ))}
  </ul>
  <p class="home-links">
    <a class="tap-target" href={pathOf('methodology', locale)}>
      {text('page.home.links.methodology')}
    </a>
    <a class="tap-target" href={pathOf('about', locale)}>
      {text('page.home.links.about')}
    </a>
  </p>
</BaseLayout>

<style>
  /* The one place the Blueprint identity is spent: the grid on the ink and one dimension line. */
  .home-hero {
    --grid-line: color-mix(in srgb, var(--color-surface) 12%, transparent);
    margin: 0 calc(-1 * var(--space-3)) var(--space-5);
    padding: var(--space-5) var(--space-3);
    background: var(--color-text);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 0),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 0);
    background-size: var(--grid-size) var(--grid-size);
    color: var(--color-surface);
  }

  .home-hero h1 {
    width: fit-content;
    font-size: var(--text-display);
  }

  /* The dimension line measures the heading: two end ticks one grid cell tall and a centre line. */
  .home-hero h1::after {
    content: '';
    display: block;
    height: var(--grid-size);
    margin-top: var(--space-2);
    border-inline: var(--tick-weight) solid var(--color-accent);
    background: linear-gradient(var(--color-accent), var(--color-accent)) center / 100%
      var(--tick-weight) no-repeat;
  }

  .home-hero p {
    max-width: var(--measure);
    margin: 0;
  }

  /* Once the hero no longer reaches the screen edges (the page width plus its two gutters), it takes
     the card corners of the mockups. */
  @media (min-width: 66rem) {
    .home-hero {
      border-radius: var(--radius-card);
    }
  }

  .home-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  /* One link per card, stretched over it; the border darkens on hover and focus with no shift. */
  .home-card {
    position: relative;
    padding: var(--space-3);
    border: 2px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .home-card:hover,
  .home-card:focus-within {
    border-color: var(--color-text);
  }

  .home-card h2 {
    margin: 0 0 var(--space-2);
  }

  /* The title is ink, as the mockup cards; the whole card is the link and it underlines on hover. */
  .home-card a {
    color: var(--color-text);
    text-decoration: none;
  }

  .home-card a:hover {
    text-decoration: underline;
  }

  .home-card a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .home-card p {
    margin: 0 0 var(--space-2);
  }

  .home-card .home-example {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
