---
/** The guides of a calculator page (guides): one link to each guide that ends in this calculator. */
interface Props {
  label: string;
  guides: readonly { href: string; title: string }[];
}
const { label, guides } = Astro.props;
---

<aside class="guide-links" aria-label={label}>
  <p>{label}</p>
  <ul>
    {guides.map(({ href, title }) => (
      <li>
        <a {href}>{title}</a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .guide-links {
    margin-block: var(--space-4);
    padding: var(--space-3);
    border: 2px solid var(--color-text);
    border-radius: 4px;
    background: var(--color-surface);
  }

  .guide-links p {
    margin: 0 0 var(--space-2);
  }

  .guide-links ul {
    margin: 0;
    padding-inline-start: var(--space-4);
  }

  .guide-links a {
    font-weight: 600;
  }
</style>
