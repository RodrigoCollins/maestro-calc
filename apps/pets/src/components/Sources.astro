---
import { BYLINE_TEXTS, SOURCES_ID } from '../editorial.ts';
import type { PageSource } from '../guides.ts';

/** The sources section a byline links to: every source the page cites, once each. */
interface Props {
  readonly sources: readonly PageSource[];
}
---

<section class="bf-card" aria-labelledby={SOURCES_ID}>
  <h2 id={SOURCES_ID}>{BYLINE_TEXTS.sources}</h2>
  <ul>
    {Astro.props.sources.map(({ name, url }) => (
      <li>
        <a href={url}>{name}</a>
      </li>
    ))}
  </ul>
</section>
