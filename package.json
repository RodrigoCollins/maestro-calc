{
  "name": "maestro-calc",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @maestro-calc/web",
    "build": "npm run build -w @maestro-calc/web",
    "build:pay": "npm run build -w @maestro-calc/pay",
    "build:pets": "npm run build -w @maestro-calc/pets",
    "build:pool": "npm run build -w @maestro-calc/pool",
    "build:lawn": "npm run build -w @maestro-calc/lawn",
    "check:site:lawn": "npm run check:site -w @maestro-calc/lawn",
    "check:site:pets": "npm run check:site -w @maestro-calc/pets",
    "check:site:pool": "npm run check:site -w @maestro-calc/pool",
    "preview": "npm run preview -w @maestro-calc/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "check": "npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation": "node scripts/mutation.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:site": "npm run check:site -w @maestro-calc/web",
    "check:site:pay": "npm run check:site -w @maestro-calc/pay",
    "test:e2e": "npm test --prefix tooling/site-browser",
    "test:e2e:pay": "npm run test:pay --prefix tooling/site-browser",
    "test:e2e:pets": "npm run test:pets --prefix tooling/site-browser",
    "test:e2e:pool": "npm run test:pool --prefix tooling/site-browser",
    "test:e2e:lawn": "npm run test:lawn --prefix tooling/site-browser",
    "lighthouse": "npm run lighthouse --prefix tooling/site-browser",
    "sync": "npm run astro -w @maestro-calc/web -- sync",
    "lint": "eslint . --max-warnings=0",
    "lint:fast": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run sync && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:site && npm run build:pay && npm run check:site:pay && npm run build:pool && npm run check:site:pool && npm run build:lawn && npm run check:site:lawn && npm run build:pets && npm run check:site:pets && npm run check:dist"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
