---
import type { LongTailSection } from '../long-tail/sections.ts';

interface Props {
  /** Explained sections: a heading, paragraphs, steps, a table, more paragraphs and links. */
  readonly sections: readonly LongTailSection[];
}

const { sections } = Astro.props;
---

{sections.map((section) => (
  <section aria-labelledby={section.id}>
    <h2 id={section.id}>{section.heading}</h2>
    {section.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    {section.steps !== undefined && (
      <ol class="rules">
        {section.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    )}
    {section.table !== undefined && (
      <div
        class="table-scroll"
        role="region"
        aria-labelledby={`${section.id}-caption`}
        tabindex="0"
      >
        <table class="ledger figures">
          <caption id={`${section.id}-caption`}>{section.table.caption}</caption>
          <thead>
            <tr>
              {section.table.head.map((cell) => (
                <th scope="col">{cell}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {section.table.rows.map(([first, ...rest]) => (
              <tr>
                <th scope="row">{first}</th>
                {rest.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {(section.after ?? []).map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    {(section.questions ?? []).map(({ question, answer }) => (
      <>
        <h3>{question}</h3>
        <p>{answer}</p>
      </>
    ))}
    {section.links !== undefined && (
      <ul class="link-list">
        {section.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    )}
  </section>
))}
