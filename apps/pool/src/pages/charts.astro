---
import Layout from '../components/Layout.astro';
import { CHARTS_INDEX, DATA_PAGES, checkedText } from '../charts.ts';

const { title, description, h1, lead, press } = CHARTS_INDEX;
---

<Layout {title} {description}>
  <main class="pool-page">
    <p class="pool-kicker">Data · free to cite</p>
    <h1>{h1}</h1>
    <p>{lead}</p>
    <ul class="pool-data">
      {DATA_PAGES.map(({ path, name, summary, checked, owners }) => (
        <li>
          <h2>
            <a href={path}>{name}</a>
          </h2>
          <p>{summary}</p>
          <p class="pool-data-meta">
            Checked <time datetime={checked}>{checkedText(checked)}</time>. Sources:{' '}
            {owners.join(', ')}.
          </p>
        </li>
      ))}
    </ul>
    <section class="pool-press" aria-labelledby="press">
      <h2 id="press">{press.heading}</h2>
      <p>
        {press.text} <a href={`mailto:${press.email}`}>{press.email}</a>.
      </p>
    </section>
  </main>
</Layout>

<style>
  .pool-data {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pool-data li,
  .pool-press {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 3px solid var(--ink);
    background: #ffffff;
  }

  .pool-data h2,
  .pool-press h2 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
    text-transform: uppercase;
    line-height: 1;
  }

  .pool-data-meta {
    font-size: 1rem;
  }
</style>
