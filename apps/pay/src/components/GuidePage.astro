---
import { hoursText, moneyText } from '../format.ts';
import type { GuideTexts, LedgerLine } from '../guide/texts.ts';
import { HOME_TEXTS } from '../home/texts.ts';
import type { CommonLinks } from '../long-tail/jobs.ts';
import { figuresOf, type WorkedWeek } from '../methodology/examples.ts';
import type { Lang } from '../time-card/receipt.ts';
import { TIME_CARD_TEXTS } from '../time-card/texts.ts';
import SiteLayout from './SiteLayout.astro';

interface Props {
  readonly lang: Lang;
  readonly texts: GuideTexts;
  readonly paths: Readonly<Record<Lang, string>>;
  /** The weeks the guide works out; their figures are the time card's own. */
  readonly weeks?: readonly WorkedWeek[];
  /** The lines of a worked ledger (a sample pay stub), computed by the guide's module. */
  readonly ledger?: readonly LedgerLine[];
  /** Related pages listed under a heading, such as the long-tail pages of a calculator. */
  readonly links?: CommonLinks;
}

const { lang, texts: t, paths, weeks = [], ledger = [], links } = Astro.props;
const examples = t.examples;
if (weeks.length > 0 && examples === undefined) throw new Error(`${paths.en} has no example texts`);
// The rows are the engine's own figures for each week (the guide's test pins them).
const rows = weeks.map((week) => {
  const label = examples?.labels[week.id];
  if (label === undefined) throw new Error(`${paths[lang]} has no label for ${week.id}`);
  const figures = figuresOf(week);
  return {
    label,
    regular: hoursText(figures.regularHours),
    overtime: hoursText(figures.overtimeHours),
    double: hoursText(figures.doubleHours),
    pay: moneyText(figures.pay),
  };
});
const ledgerTexts = t.ledger;
if (ledger.length > 0 && ledgerTexts === undefined)
  throw new Error(`${paths.en} has no ledger texts`);
const ledgerRows = ledger.map((line) => {
  const label = ledgerTexts?.labels[line.id];
  if (label === undefined) throw new Error(`${paths[lang]} has no label for ${line.id}`);
  return { label, kind: line.kind, detail: line.detail, amount: moneyText(line.amount) };
});
---

<SiteLayout
  lang={lang}
  title={t.title}
  description={t.description}
  paths={paths}
  otherLang={TIME_CARD_TEXTS[lang].otherLang}
  footer={HOME_TEXTS[lang].sources}
>
  <main class="page prose">
    <div>
      <p class="kicker">{t.kicker}</p>
      <h1>{t.h1}</h1>
    </div>
    <p class="lead">{t.lead}</p>

    {t.sections.map((section) => (
      <section aria-labelledby={section.id}>
        <h2 id={section.id}>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <p class="sources">
          {t.sourcesLabel}:{' '}
          {section.sources.map((source, index) => (
            <>
              {index > 0 && '; '}
              <a href={source.href} rel="noopener">
                {source.label}
              </a>
            </>
          ))}
        </p>
      </section>
    ))}

    {examples !== undefined && rows.length > 0 && (
      <section aria-labelledby="examples">
        <h2 id="examples">{examples.heading}</h2>
        <p>{examples.lead}</p>
        <ul class="examples">
          {rows.map((row) => (
            <li>
              <p class="example-label">{row.label}</p>
              <dl>
                <div>
                  <dt>{examples.columns.regular}</dt>
                  <dd>{row.regular}</dd>
                </div>
                <div>
                  <dt>{examples.columns.overtime}</dt>
                  <dd>{row.overtime}</dd>
                </div>
                <div>
                  <dt>{examples.columns.double}</dt>
                  <dd>{row.double}</dd>
                </div>
                <div class="example-pay">
                  <dt>{examples.columns.pay}</dt>
                  <dd>{row.pay}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
      </section>
    )}

    {ledgerTexts !== undefined && ledgerRows.length > 0 && (
      <section aria-labelledby="ledger">
        <h2 id="ledger">{ledgerTexts.heading}</h2>
        <p>{ledgerTexts.lead}</p>
        <table class="ledger">
          <tbody>
            {ledgerRows.map((row) => (
              <tr class={row.kind}>
                <th scope="row">
                  {row.label}
                  {row.detail !== undefined && <span>{row.detail}</span>}
                </th>
                <td>{row.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note">{ledgerTexts.note}</p>
      </section>
    )}

    <p class="note">
      {t.disclaimer} {t.reviewed}
    </p>
    {t.ctas.map((cta, index) => (
      <a
        class:list={['button', index === 0 ? 'button-primary' : 'button-secondary']}
        href={cta.href}
      >
        {cta.label}
      </a>
    ))}

    {links !== undefined && links.links.length > 0 && (
      <section aria-labelledby="related-heading">
        <h2 id="related-heading">{links.heading}</h2>
        <ul class="link-list">
          {links.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</SiteLayout>
