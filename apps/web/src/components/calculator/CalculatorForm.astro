---
import { labelId } from '../../calculator/ids.ts';
import CalculatorField from './CalculatorField.astro';
import type { Choice, FormView } from './model.ts';

interface Props {
  form: FormView;
}
const { unitsLabel, units, items, copyLabel } = Astro.props.form;
const pressed = (choice: Choice): 'true' | 'false' => (choice.pressed ? 'true' : 'false');
---

<form class="calc-form" autocomplete="off" novalidate>
  <div class="calc-group" role="group" aria-labelledby="calc-units-label">
    <span class="calc-legend" id="calc-units-label">
      {unitsLabel}
    </span>
    {units.map((choice) => (
      <button
        class="calc-choice"
        type="button"
        data-unit={choice.id}
        aria-pressed={pressed(choice)}
        disabled
      >
        {choice.label}
      </button>
    ))}
  </div>
  {items.map((item) =>
    item.kind === 'choice' ? (
      <Fragment>
        <div
          class="calc-group"
          role="group"
          aria-labelledby={labelId(item.key)}
          data-choice={item.key}
        >
          <span class="calc-legend" id={labelId(item.key)}>
            {item.label}
          </span>
          {item.choices.map((choice) => (
            <button
              class="calc-choice"
              type="button"
              value={choice.id}
              aria-pressed={pressed(choice)}
              disabled
            >
              {choice.label}
            </button>
          ))}
        </div>
        {item.area !== undefined && (
          <div class="calc-choice-area" style={`--calc-rows:${String(item.area.rows)}`}>
            {item.area.fields.map((field) => (
              <CalculatorField {field} hidden={!field.visible} />
            ))}
          </div>
        )}
      </Fragment>
    ) : (
      <Fragment>
        <CalculatorField field={item.field} />
        {item.stepper !== undefined && (
          <div class="calc-steppers" data-step={item.stepper.key}>
            <button class="calc-choice" type="button" value="less" hidden disabled>
              {item.stepper.less}
            </button>
            <button class="calc-choice" type="button" value="more" hidden disabled>
              {item.stepper.more}
            </button>
          </div>
        )}
      </Fragment>
    ),
  )}
  <div class="calc-copy" data-reserved="copy">
    <button class="calc-choice" type="button" data-copy hidden disabled>
      {copyLabel}
    </button>
    <p class="calc-status" data-copy-status role="status"></p>
  </div>
</form>
