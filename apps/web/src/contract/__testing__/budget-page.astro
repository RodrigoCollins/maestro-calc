---
import type { Locale } from '@maestro-calc/i18n';
import { getEntry } from 'astro:content';
import CalculatorBody from '../../components/calculator/CalculatorBody.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageView } from '../../lib/pages.ts';
import { CALCULATOR_PAGES, isCalculatorPage } from '../../routing/templates.ts';
import { siteText } from '../../lib/site-text.ts';
import { headFor } from '../../seo/head.ts';
import { LOCALES, ROUTES } from '../../routing/routes.ts';
import { calculatorJsonLd, serializeJsonLd } from '../../seo/json-ld.ts';
import { SCRIPTS } from '../../views/scripts.ts';
import { budgetPaths, entryOrThrow, extraOf } from './budget-paths.ts';
import { copyOf, faqOf } from './budget-copy.ts';

export const getStaticPaths = () => budgetPaths(CALCULATOR_PAGES, LOCALES);

// Test support: the budget proof builds this page with the real pipeline and measures the file.
const locale: Locale = Astro.params['locale'] === 'es' ? 'es' : 'en';
const id = Astro.params['id'] ?? '';
if (!isCalculatorPage(id)) throw new Error(`no calculator page ${id}`);
const extra = extraOf(process.env, id, locale);
const text = siteText(locale);
const view = pageView(id, locale);
const entry = entryOrThrow(await getEntry('calculators', `${locale}/${id}`), id, locale);
// The real builder with the real serializer, over the full-length FAQ, with the routed paths.
const jsonLd = serializeJsonLd(
  calculatorJsonLd({ id, name: view.title }, locale, faqOf(locale), ROUTES),
);
// The real head and the real island: the measured page differs from the routed one only in its copy.
const Script = SCRIPTS[id];
const content = {
  updatedLabel: text('site.trust.updated'),
  updated: entry.data.updated,
  updatedText: entry.data.updated,
  sources: entry.data.sources,
};
---

<BaseLayout {locale} {id} head={{ ...headFor(id, locale, text), jsonLd }}>
  <CalculatorBody {view} {content}>
    <Fragment set:html={copyOf(locale, extra)} />
  </CalculatorBody>
  <Script />
</BaseLayout>
