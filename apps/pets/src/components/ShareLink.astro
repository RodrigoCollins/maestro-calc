---
import { canonicalUrl } from '@maestro-calc/site-kit/canonical';
import { langOf } from '../routes.ts';
import { nameOf } from '../seo/json-ld.ts';
import { shareMessage, whatsappHref } from '../share/href.ts';
import { SITE } from '../site.config.ts';

/** The WhatsApp share link of a page: plain words and its address, no script of WhatsApp's. */
interface Props {
  readonly path: string;
  readonly title: string;
}

const { path, title } = Astro.props;
// the words of the link in the page's language; French puts a space before the colon
const words = {
  en: { on: `on ${SITE.name}:`, label: 'Share on WhatsApp' },
  de: { on: `auf ${SITE.name}:`, label: 'Per WhatsApp teilen' },
  fr: { on: `sur ${SITE.name} :`, label: 'Partager sur WhatsApp' },
  es: { on: `en ${SITE.name}:`, label: 'Compartir por WhatsApp' },
}[langOf(path)];
const text = `${nameOf(title)}, ${words.on}`;
const label = words.label;
---

<a
  class="bf-share"
  data-share={text}
  href={whatsappHref(shareMessage(text, canonicalUrl(path, SITE.origin)))}
  aria-label={`${label}: ${nameOf(title)}`}
>
  {label}
</a>
