---
import { CHARTS_INDEXES, DATA_PAGES_OF, DATA_TEXTS, checkedText } from '../charts.ts';
import { langOf } from '../routes.ts';

interface Props {
  /** The data page this line closes; one the index does not list throws at build time. */
  readonly path: string;
}

const { path } = Astro.props;
const lang = langOf(path);
const index = CHARTS_INDEXES[lang];
const text = DATA_TEXTS[lang];
const page = DATA_PAGES_OF[lang].find((candidate) => candidate.path === path);
if (page === undefined) throw new Error(`${path} is not in the data index`);
---

<p class="pool-data-link">
  {text.checked} {checkedText(page.checked, lang)}. {text.all}{' '}
  <a href={index.path}>{index.name.toLowerCase()}</a>
  {text.free}
</p>

<style>
  .pool-data-link {
    font-size: 1rem;
  }
</style>
