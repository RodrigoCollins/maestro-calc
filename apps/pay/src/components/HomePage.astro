---
import { timeCard } from '@maestro-calc/pay-core/time-card';
import { hoursText, moneyText, shiftText } from '../format.ts';
import { OVERTIME_GUIDE_PATHS, OVERTIME_GUIDES } from '../guide/overtime.ts';
import { PAY_STUB_GUIDE, PAY_STUB_GUIDE_PATHS } from '../guide/pay-stub.ts';
import { PTO_GUIDE, PTO_GUIDE_PATHS } from '../guide/pto.ts';
import { SHIFT_GUIDE, SHIFT_GUIDE_PATHS } from '../guide/shift-differential.ts';
import { GUIDE_PATHS, GUIDE_TEXTS } from '../guide/texts.ts';
import { HOURS_WORKED_GUIDE, HOURS_WORKED_GUIDE_PATHS } from '../guide/hours-worked.ts';
import { TIP_CREDIT_GUIDE, TIP_CREDIT_GUIDE_PATHS } from '../guide/tip-credit.ts';
import {
  MINIMUM_WAGE_2027_GUIDE,
  MINIMUM_WAGE_2027_GUIDE_PATHS,
} from '../guide/minimum-wage-2027.ts';
import {
  MINIMUM_WAGE_STATES_GUIDE,
  MINIMUM_WAGE_STATES_GUIDE_PATHS,
} from '../guide/minimum-wage-states.ts';
import { OVERTIME_STATES_GUIDE, OVERTIME_STATES_GUIDE_PATHS } from '../guide/overtime-states.ts';
import { TIPPED_STATES_GUIDE, TIPPED_STATES_GUIDE_PATHS } from '../guide/tipped-states.ts';
import { UNPAID_WAGES_GUIDE, UNPAID_WAGES_GUIDE_PATHS } from '../guide/unpaid-wages.ts';
import { W2_BOX_12_GUIDE, W2_BOX_12_GUIDE_PATHS } from '../guide/w2-box-12.ts';
import { HOME_TEXTS } from '../home/texts.ts';
import { outputOf, type Lang } from '../time-card/receipt.ts';
import { TIME_CARD_TEXTS } from '../time-card/texts.ts';
import SiteLayout from './SiteLayout.astro';

interface Props {
  readonly lang: Lang;
}

const { lang } = Astro.props;
const t = HOME_TEXTS[lang];
const guides = [
  ...(['federal', 'california'] as const).map((guide) => ({
    href: OVERTIME_GUIDE_PATHS[guide][lang],
    label: OVERTIME_GUIDES[guide][lang].linkLabel,
  })),
  { href: PAY_STUB_GUIDE_PATHS[lang], label: PAY_STUB_GUIDE[lang].linkLabel },
  { href: UNPAID_WAGES_GUIDE_PATHS[lang], label: UNPAID_WAGES_GUIDE[lang].linkLabel },
  { href: PTO_GUIDE_PATHS[lang], label: PTO_GUIDE[lang].linkLabel },
  { href: SHIFT_GUIDE_PATHS[lang], label: SHIFT_GUIDE[lang].linkLabel },
  { href: TIP_CREDIT_GUIDE_PATHS[lang], label: TIP_CREDIT_GUIDE[lang].linkLabel },
  { href: TIPPED_STATES_GUIDE_PATHS[lang], label: TIPPED_STATES_GUIDE[lang].linkLabel },
  { href: OVERTIME_STATES_GUIDE_PATHS[lang], label: OVERTIME_STATES_GUIDE[lang].linkLabel },
  {
    href: MINIMUM_WAGE_STATES_GUIDE_PATHS[lang],
    label: MINIMUM_WAGE_STATES_GUIDE[lang].linkLabel,
  },
  { href: MINIMUM_WAGE_2027_GUIDE_PATHS[lang], label: MINIMUM_WAGE_2027_GUIDE[lang].linkLabel },
  { href: HOURS_WORKED_GUIDE_PATHS[lang], label: HOURS_WORKED_GUIDE[lang].linkLabel },
  { href: GUIDE_PATHS[lang], label: GUIDE_TEXTS[lang].h1 },
  { href: W2_BOX_12_GUIDE_PATHS[lang], label: W2_BOX_12_GUIDE[lang].linkLabel },
];
// The card in the hero is the calculator's own default week, so its figures are the engine's.
const ran = timeCard.run({});
if (!ran.ok) throw new Error('the default week of the time card must run');
const result = ran.value;
const defaults: Readonly<Record<string, unknown>> = Object.fromEntries(
  timeCard.inputs.map((input) => [input.key, input.default]),
);
const clock = (key: string): number | null => (defaults[key] as number | null | undefined) ?? null;
const rows = TIME_CARD_TEXTS[lang].days.slice(0, 3).map((day) => ({
  day: day.short,
  shift: shiftText(clock(day.key), clock(`${day.key}Out`)),
  hours: hoursText(outputOf(result, `${day.key}Hours` as 'monHours')),
}));
---

<SiteLayout
  lang={lang}
  title={t.title}
  description={t.description}
  paths={{ en: '/', es: '/es' }}
  otherLang={TIME_CARD_TEXTS[lang].otherLang}
  footer={t.sources}
  wide
>
  <main class="page home">
    <section class="hero">
      <div class="hero-copy">
        <p class="kicker">{t.kicker}</p>
        <h1>{t.h1}</h1>
        <p class="lead">{t.lead}</p>
        <a class="button button-money" href={t.cta.href}>
          {t.cta.label}
        </a>
      </div>
      <div class="mini-card" aria-hidden="true">
        <p class="mini-head">
          <span>{t.cardTitle}</span>
          <span class="stamp">{hoursText(outputOf(result, 'totalHours'))} H</span>
        </p>
        {rows.map((row) => (
          <p class="mini-row">
            <span>
              {row.day} {row.shift}
            </span>
            <span>{row.hours}</span>
          </p>
        ))}
        <p class="mini-row mini-total">
          <span>{t.cardTotal}</span>
          <span>{moneyText(outputOf(result, 'pay'))}</span>
        </p>
      </div>
    </section>

    <section class="tools" aria-labelledby="tools-heading">
      <h2 id="tools-heading">{t.toolsHeading}</h2>
      <ul>
        {t.tools.map((tool) =>
          tool.href === null ? (
            <li class="tool tool-soon">
              <span class="tool-title">
                {tool.title}
                <span class="badge">{t.soon}</span>
              </span>
              <span class="tool-summary">{tool.summary}</span>
            </li>
          ) : (
            <li>
              <a class="tool" href={tool.href}>
                <span class="tool-title">{tool.title}</span>
                <span class="tool-summary">{tool.summary}</span>
              </a>
            </li>
          ),
        )}
      </ul>
    </section>

    <section class="guides" aria-labelledby="guides-heading">
      <h2 id="guides-heading">{t.guidesHeading}</h2>
      <ul class="link-list">
        {guides.map((guide) => (
          <li>
            <a href={guide.href}>{guide.label}</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</SiteLayout>
