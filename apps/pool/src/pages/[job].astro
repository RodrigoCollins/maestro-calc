---
import type { GetStaticPaths } from 'astro';
import Byline from '../components/Byline.astro';
import Layout from '../components/Layout.astro';
import JobLinks from '../components/JobLinks.astro';
import Sources from '../components/Sources.astro';
import { JOB_PAGES, type JobPage } from '../jobs.ts';
import { jobTrailOf } from '../seo/breadcrumb.ts';
import { VOLUME_CHART } from '../volume/chart.ts';

// One page per common job, its figures worked out by the engines at build time (no script).
export const getStaticPaths = (() =>
  JOB_PAGES.map((page) => ({
    params: { job: page.path.slice(1) },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: JobPage };
const trail = jobTrailOf(page);
const here = trail.at(-1);
---

<Layout title={page.title} description={page.description} {trail}>
  <main class="pool-page">
    <nav aria-label="Breadcrumb">
      <ol class="pool-crumbs">
        {trail.slice(0, -1).map(({ name, path }) => (
          <li>
            <a href={path}>{name}</a>
          </li>
        ))}
        <li aria-current="page">{here?.name}</li>
      </ol>
    </nav>
    <h1>{page.h1}</h1>
    <Byline path={page.path} />
    <p>{page.lead}</p>
    <figure class="pool-job-figure">
      <p class="pool-marker">
        {page.figure.value}
        <small>{page.figure.unit}</small>
      </p>
      <figcaption>{page.figure.caption}</figcaption>
    </figure>
    <table class="pool-job-table">
      <thead>
        <tr>
          {page.head.map((cell) => (
            <th scope="col">{cell}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {page.rows.map(({ cells: [label, ...figures] }) => (
          <tr>
            <th scope="row">{label}</th>
            {figures.map((cell) => (
              <td>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      <a href={page.calculator.href}>{page.calculator.label}</a>
    </p>
    {page.calculator.path === VOLUME_CHART.calculator.href && (
      <p>
        <a href={VOLUME_CHART.path}>Every common size in the pool volume chart</a>
      </p>
    )}
    {page.guide !== undefined && (
      <p>
        <a href={page.guide.href}>{page.guide.label}</a>
      </p>
    )}
    <p class="pool-job-method">{page.method}</p>
    <Sources path={page.path} />
    <JobLinks page={page} />
  </main>
</Layout>

<style>
  .pool-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .pool-crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
  }

  .pool-job-figure {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .pool-job-table {
    border-collapse: collapse;
    background: #ffffff;
    font-variant-numeric: tabular-nums;
  }

  .pool-job-table th,
  .pool-job-table td {
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--ink);
    text-align: right;
  }

  .pool-job-table th[scope='row'] {
    text-align: left;
  }

  .pool-job-method {
    font-size: 0.9375rem;
  }
</style>
