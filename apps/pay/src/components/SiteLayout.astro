---
import { Font } from 'astro:assets';
import { canonicalUrl } from '@maestro-calc/site-kit/canonical';
import type { Lang } from '../time-card/receipt.ts';
import { ROUTES } from '../routes.ts';
import { EMBED_TEXTS } from '../embed/texts.ts';
import { DATA_PATHS, DATA_TEXTS } from '../data/texts.ts';
import { EDITORIAL_PATHS } from '../editorial/paths.ts';
import { embedHeadOf, headOf } from '../seo/head.ts';
import { jsonLdOf, type Parent } from '../seo/json-ld.ts';
import { SITE } from '../site.config.ts';
import { STATES_INDEX_PATHS } from '../states/routes.ts';
import { statesIndexOf } from '../states/pages.ts';
import '../styles/site.css';

interface Props {
  readonly lang: Lang;
  readonly title: string;
  readonly description: string;
  /**
   * This page's path in each language; the English one is also the x-default. A page without
   * paths (the 404) has no canonical or alternates, is never indexed and links the other home.
   */
  readonly paths?: Readonly<Record<Lang, string>>;
  /** The calculator a long-tail page answers for: the middle step of its breadcrumb. */
  readonly parent?: Parent;
  /** The day the page's data says it was last checked, `YYYY-MM-DD`: its JSON-LD `dateModified`. */
  readonly modified?: string;
  readonly otherLang: string;
  readonly footer: string;
  readonly wide?: boolean;
  /**
   * The embed of the page (`src/embed/embeds.ts`), another site's frame: canonical at the full
   * page, `noindex`, no alternates, JSON-LD or analytics, every link in a new tab but the language
   * switch, which stays in the frame, and no footer (the credit link sits under the frame).
   */
  readonly embed?: boolean;
}

const {
  lang,
  title,
  description,
  paths,
  parent,
  modified,
  otherLang,
  footer,
  wide = false,
} = Astro.props;
const embedded = Astro.props.embed === true && paths !== undefined;
const other: Lang = lang === 'en' ? 'es' : 'en';
const embedHead = embedded ? embedHeadOf(paths, lang, { title, description }) : undefined;
const otherHref = embedHead?.other ?? paths?.[other] ?? (other === 'en' ? '/' : '/es');
const { canonical, robots, preview } = embedHead ?? headOf(paths, lang, { title, description });
const route = paths === undefined ? undefined : ROUTES.find(({ en }) => en === paths.en);
const jsonLd =
  route === undefined || embedded
    ? undefined
    : jsonLdOf(
        route,
        lang,
        { title, description, ...(modified === undefined ? {} : { modified }) },
        SITE.origin,
        parent,
      );
const homeHref = embedded ? canonical : lang === 'en' ? '/' : '/es';
const href = (path: string): string => canonicalUrl(path, SITE.origin);
const method =
  lang === 'en'
    ? { href: '/methodology', label: 'How we calculate' }
    : { href: '/es/metodologia', label: 'Cómo calculamos' };
const privacy =
  lang === 'en'
    ? { href: '/privacy', label: 'Privacy' }
    : { href: '/es/privacidad', label: 'Privacidad' };
const about =
  lang === 'en' ? { href: '/about', label: 'About' } : { href: '/es/acerca', label: 'Acerca de' };
const editorial = lang === 'en' ? 'Editorial policy' : 'Política editorial';
const embedLink =
  lang === 'en'
    ? { href: '/embed-calculators', label: EMBED_TEXTS.en.footerLabel }
    : { href: '/es/calculadoras-para-tu-sitio', label: EMBED_TEXTS.es.footerLabel };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robots !== undefined && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={preview['og:title']} />
    <meta property="og:description" content={preview['og:description']} />
    {canonical !== undefined && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_US'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_US' : 'en_US'} />
    <meta property="og:image" content={preview['og:image']} />
    <meta property="og:image:width" content={preview['og:image:width']} />
    <meta property="og:image:height" content={preview['og:image:height']} />
    <meta name="twitter:card" content={preview['twitter:card']} />
    {SITE.pinterestVerify !== '' && <meta name="p:domain_verify" content={SITE.pinterestVerify} />}
    {jsonLd !== undefined && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    {embedded && <base target="_blank" />}
    {embedded && <link rel="canonical" href={canonical} />}
    {paths !== undefined && !embedded && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en-US" href={href(paths.en)} />
        <link rel="alternate" hreflang="es-US" href={href(paths.es)} />
        <link rel="alternate" hreflang="x-default" href={href(paths.en)} />
      </>
    )}
    <Font cssVariable="--font-body" preload={[{ weight: '800' }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: '400' }]} />
    {SITE.gaId !== '' && !embedded && (
      <script
        is:inline
        src="/analytics.js"
        data-ga={SITE.gaId}
        data-host={new URL(SITE.origin).hostname}
        defer
      />
    )}
  </head>
  <body class:list={{ wide }}>
    <header class="site-header">
      <div>
        <a class="brand" href={homeHref}>
          <svg
            width="26"
            height="26"
            viewBox="0 0 26 26"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <rect x="4" y="2" width="18" height="22" rx="2"></rect>
            <path d="M8 7h10M8 11h10M8 15h6"></path>
            <circle cx="18" cy="19" r="2.2" fill="#e0a23b" stroke="none"></circle>
          </svg>
          {SITE.name}
        </a>
        <a
          class="lang"
          href={otherHref}
          hreflang={other}
          lang={other}
          target={embedded ? '_self' : undefined}
        >
          {otherLang}
        </a>
      </div>
    </header>
    <slot />
    {!embedded && (
      <footer class="site-footer">
        <div>
          <span>{SITE.name}</span>
          <span>{footer}</span>
          <a href={method.href}>{method.label}</a>
          <a href={privacy.href}>{privacy.label}</a>
          <a href={about.href}>{about.label}</a>
          <a href={EDITORIAL_PATHS[lang]}>{editorial}</a>
          <a href={embedLink.href}>{embedLink.label}</a>
          <a href={DATA_PATHS[lang]}>{DATA_TEXTS[lang].linkLabel}</a>
          <a href={STATES_INDEX_PATHS[lang]}>{statesIndexOf(lang).linkLabel}</a>
        </div>
      </footer>
    )}
  </body>
</html>
