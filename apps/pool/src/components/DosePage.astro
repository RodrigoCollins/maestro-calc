---
import type { Calculator, InputDescriptor, OutputDescriptor } from '@maestro-calc/core';
import type { DosePage } from '../doses.ts';
import { amountText, outputText } from '../format.ts';
import JobLinks from './JobLinks.astro';
import Layout from './Layout.astro';

interface Props {
  readonly page: DosePage;
  readonly calculator: Calculator<
    string,
    readonly InputDescriptor[],
    readonly OutputDescriptor[],
    readonly string[]
  >;
  /** The embed of the page (`src/embed.ts`): the same calculator in the slim shell. */
  readonly embed?: boolean;
}

const { page, calculator, embed = false } = Astro.props;
// The page renders the engine's default result, so it reads complete with no script.
const ran = calculator.run({});
if (!ran.ok) throw new Error(`${calculator.id} must run at its defaults`);
const out = new Map<string, unknown>(ran.value.outputs.map(({ key, value }) => [key, value]));
const fields = calculator.inputs.map((input) => {
  const copy = page.fields[input.key];
  if (copy === undefined) throw new Error(`no label for ${input.key}`);
  return {
    key: input.key,
    label: copy.label,
    value:
      input.kind === 'select'
        ? input.default
        : input.kind === 'decimal'
          ? amountText(input.default).replaceAll(',', '')
          : input.kind === 'count'
            ? String(input.default)
            : '',
    inputmode: input.kind === 'count' ? ('numeric' as const) : ('decimal' as const),
    options: copy.options === undefined ? undefined : Object.entries(copy.options),
  };
});
const product = fields.find(({ key }) => key === 'product')?.value;
const [lead, ...rest] = page.results;
// a page with products leads with one figure per product, its detail rows under them
const leads = page.results.filter(({ forms, detail }) => forms !== undefined && detail !== true);
const primaries = leads.length > 0 ? leads : lead === undefined ? [] : [lead];
const rows = leads.length > 0 ? page.results.filter(({ detail }) => detail === true) : rest;
const shown = (forms: readonly string[] | undefined): boolean =>
  forms === undefined || forms.includes(product ?? '');
const reading = fields.find(({ key }) => key === page.strip?.field)?.value;
const warned = new Set(ran.value.warnings.map(({ code }) => code));
---

<Layout title={page.title} description={page.description} {embed}>
  <main class="pool-page">
    <p class="pool-kicker">{page.kicker}</p>
    <h1>{page.h1}</h1>
    <p>{page.lead}</p>
    <form class="pool-form" data-calculator={calculator.id} novalidate>
      {fields.map((field) => (
        <label>
          {field.label}
          {field.options === undefined ? (
            <input
              name={field.key}
              inputmode={field.inputmode}
              autocomplete="off"
              value={field.value}
            />
          ) : (
            <select name={field.key}>
              {field.options.map(([value, label]) => (
                <option value={value} selected={value === field.value}>
                  {label}
                </option>
              ))}
            </select>
          )}
        </label>
      ))}
    </form>
    {page.strip !== undefined && (
      <fieldset class="pool-strip" data-strip={page.strip.field}>
        <legend>{page.strip.legend}</legend>
        <div>
          {page.strip.pads.map(({ ppm, color }) => (
            <button type="button" data-pad={ppm} aria-pressed={ppm === reading ? 'true' : 'false'}>
              <span style={`background:${color}`} />
              {ppm}
            </button>
          ))}
        </div>
        <p>{page.strip.note}</p>
      </fieldset>
    )}
    <section class="pool-result" aria-live="polite">
      {primaries.map((result) => (
        <div data-forms={result.forms?.join(' ')} hidden={!shown(result.forms)}>
          <p>{result.label}</p>
          <p class="pool-marker">
            <span data-out={result.key}>{outputText(result.key, out.get(result.key))}</span>
            <small>{result.unit}</small>
          </p>
        </div>
      ))}
      {page.bags !== undefined && (
        <p class="pool-bags">
          <strong data-shop>{String(ran.value.shopping[0]?.qty ?? 0n)}</strong> {page.bags}
        </p>
      )}
      {rows.length > 0 && (
        <dl>
          {rows.map((row) => (
            <div data-forms={row.forms?.join(' ')} hidden={!shown(row.forms)}>
              <dt>{row.label}</dt>
              <dd>
                <span data-out={row.key}>{outputText(row.key, out.get(row.key))}</span> {row.unit}
              </dd>
            </div>
          ))}
        </dl>
      )}
      {Object.entries(page.warnings ?? {}).map(([code, text]) => (
        <p class="pool-warning" data-warning={code} hidden={!warned.has(code)}>
          {text}
        </p>
      ))}
    </section>
    <p class="pool-note">{page.method}</p>
    <p class="pool-note">{page.note}</p>
    <JobLinks path={page.path} {embed} />
  </main>
  <slot />
</Layout>

<style is:global>
  .pool-strip {
    margin: 0;
    padding: 0.75rem;
    border: 3px solid var(--ink);
    background: #ffffff;
  }

  .pool-strip legend {
    padding: 0 0.375rem;
    font-weight: 600;
  }

  .pool-strip div {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.375rem;
  }

  .pool-strip button {
    display: grid;
    gap: 0.25rem;
    justify-items: center;
    min-height: 4.5rem;
    padding: 0.375rem 0.25rem;
    border: 2px solid #8a8f8b;
    background: #ffffff;
    color: var(--ink);
    font:
      700 1.25rem var(--font-display),
      'Arial Narrow',
      sans-serif;
    cursor: pointer;
  }

  .pool-strip button span {
    width: 100%;
    height: 2rem;
    border: 2px solid var(--ink);
  }

  .pool-strip [aria-pressed='true'] {
    border-color: var(--teal);
    box-shadow: inset 0 0 0 2px var(--teal);
  }

  .pool-strip button:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
  }

  .pool-strip p {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
  }

  /* the pads set the field from a script: with none, the typed reading is the way in */
  @media (scripting: none) {
    .pool-strip {
      display: none;
    }
  }

  .pool-page .pool-bags {
    font-size: 1.25rem;
  }

  .pool-page .pool-warning {
    padding: 0.75rem 1rem;
    border: 3px solid #c2261e;
    background: #ffffff;
    font-weight: 600;
  }
</style>
