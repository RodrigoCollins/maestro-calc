---
import LanguageSwitch from './LanguageSwitch.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  homeHref: string;
  navLabel: string;
  links: readonly { href: string; label: string }[];
  language: { href: string; lang: string; hreflang: string; label: string };
}
const { homeHref, navLabel, links, language } = Astro.props;
---

<header class="site-header">
  <Wordmark href={homeHref} />
  <nav aria-label={navLabel}>
    {links.length > 0 && (
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a class="tap-target" {href}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    )}
    <LanguageSwitch {...language} />
  </nav>
</header>

<style is:global>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-2) var(--space-3);
  }

  .site-header nav,
  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .site-header ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
