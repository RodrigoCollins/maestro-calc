---
import { countdownPageOf } from '../dates/countdowns.ts';
import type { CountdownJob } from '../dates/routes.ts';
import { HOME_TEXTS } from '../home/texts.ts';
import { SOURCES_HEADING } from '../long-tail/sections.ts';
import { PAY_CONVERTER_TEXTS } from '../pay-converter/texts.ts';
import Sections from './Sections.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
  readonly job: CountdownJob;
}

// Spanish only: the language switch leads to the English home. With no script the answer is the
// date itself; `client/countdown.ts` counts from the visitor's own date.
const page = countdownPageOf(Astro.props.job);
const rule = Object.fromEntries(
  Object.entries(page.data).map(([key, value]) => [`data-${key}`, value]),
);
---

<SiteLayout
  lang="es"
  title={page.title}
  description={page.description}
  paths={page.paths}
  otherHref="/"
  parent={{ title: page.calculator.title, path: page.calculator.href }}
  otherLang={PAY_CONVERTER_TEXTS.es.otherLang}
  footer={HOME_TEXTS.es.sources}
>
  <main class="page">
    <div>
      <p class="kicker">{page.kicker}</p>
      <h1>{page.h1}</h1>
    </div>
    <p class="lead">{page.lead}</p>

    <section class="result" aria-labelledby="figure-label" data-countdown-rule {...rule}>
      <div>
        <p class="result-label" id="figure-label">
          {page.figureLabel}
        </p>
        <p class="result-figure" data-countdown="days">
          {page.fallback.days}
        </p>
      </div>
      <ul class="breakdown labeled" aria-label={page.figureLabel}>
        <li>
          <span>{page.labels.weeks}</span>
          <span data-countdown="weeks">{page.fallback.weeks}</span>
        </li>
        <li>
          <span>{page.labels.date}</span>
          <span data-countdown="date">{page.fallback.date}</span>
        </li>
      </ul>
    </section>

    <a class="button button-primary" href={page.calculator.href}>
      {page.calculator.label}
    </a>
    <p class="note">{page.note}</p>

    <div class="prose explained">
      <Sections sections={page.sections} />

      <section aria-labelledby="sources">
        <h2 id="sources">{SOURCES_HEADING.es}</h2>
        <ul class="link-list">
          {page.sources.map((source) => (
            <li>
              <a href={source.href} rel="noopener">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section aria-labelledby="others-heading">
      <h2 id="others-heading">{page.others.heading}</h2>
      <ul class="link-list">
        {page.others.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <script src="../client/countdown.ts"></script>
</SiteLayout>
