---
import Byline from './Byline.astro';
import DataLink from './DataLink.astro';
import Layout from './Layout.astro';
import Sources from './Sources.astro';
import { DOSING_CHARTS } from '../dosing-es.ts';
import { volumeJobPathOf } from '../jobs.ts';
import type { Lang } from '../routes.ts';
import { VOLUME_CHARTS } from '../volume/chart-es.ts';

interface Props {
  readonly lang: Lang;
}

const { lang } = Astro.props;
const chart = VOLUME_CHARTS[lang];
const dosing = DOSING_CHARTS[lang];
const {
  title,
  description,
  h1,
  lead,
  tables,
  assumptions,
  shortcuts,
  calculator,
  method,
  source,
  cite,
  page,
} = chart;
// the job pages are English only for now, so a Spanish row names its size with no link
const jobOf = (size: Readonly<Record<string, string>>) =>
  lang === 'en' ? volumeJobPathOf(size) : undefined;
---

<Layout {title} {description} modified={chart.checked}>
  <main class="pool-page">
    <p class="pool-kicker">{page.kicker}</p>
    <h1>{h1}</h1>
    <Byline path={chart.path} />
    <p>{lead}</p>
    <p>
      {page.notHere} <a href={calculator.href}>{calculator.label}</a>. {page.doses}{' '}
      <a href={dosing.path}>{dosing.h1.toLowerCase()}</a> {page.dosesAfter}
    </p>
    {tables.map(({ id, caption, note, columns, rows }) => (
      <section class="pool-dose" aria-labelledby={id}>
        <h2 {id}>{caption}</h2>
        <div class="pool-scroll" role="region" aria-label={page.region(caption)} tabindex="0">
          <table class="pool-chart">
            <thead>
              <tr>
                <th scope="col">{page.size}</th>
                {columns.map(({ head, shallow, deep, average }) => (
                  <th scope="col">
                    {head}{' '}
                    {shallow !== deep && <span class="pool-unit">{page.average(average)}</span>}
                  </th>
                ))}
                <th scope="col">{page.calculator}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(({ label, size, cells, href }) => {
                const job = jobOf(size);
                return (
                  <tr>
                    <th scope="row">{job === undefined ? label : <a href={job}>{label}</a>}</th>
                    {cells.map((value) => (
                      <td>{value}</td>
                    ))}
                    <td>
                      <a href={href} aria-label={page.openLabel(label)}>
                        {page.open}
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="pool-level-source">
          {page.gallons} {note}
        </p>
      </section>
    ))}
    <section class="pool-dose" aria-labelledby="assumptions">
      <h2 id="assumptions">{page.assumptionsHeading}</h2>
      <ul class="pool-list">
        {assumptions.map((text) => (
          <li>{text}</li>
        ))}
      </ul>
      <p>{page.shortcuts}</p>
      <ul class="pool-list">
        {shortcuts.map((text) => (
          <li>{text}</li>
        ))}
      </ul>
      <p>
        <a href={method}>{page.method}</a>
        {page.methodAfter}
      </p>
      <p class="pool-level-source">
        {page.source} <a href={source.url}>{source.name}</a>
      </p>
    </section>
    <section class="pool-dose" aria-labelledby="cite">
      <h2 id="cite">{page.citeHeading}</h2>
      <p>{page.citeText}</p>
      <p class="pool-cite">
        {cite.text} <a href={cite.url}>{cite.url}</a>
      </p>
    </section>
    <Sources path={chart.path} />
    <p class="pool-note">{page.note}</p>
    <DataLink path={chart.path} />
  </main>
</Layout>

<style>
  .pool-dose {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .pool-dose h2 {
    margin: 0;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1.75rem;
    text-transform: uppercase;
    line-height: 1;
  }

  .pool-dose p {
    margin: 0;
    line-height: 1.5;
  }

  /* a narrow phone scrolls the table, never the page */
  .pool-scroll {
    max-width: 100%;
    overflow-x: auto;
  }

  .pool-chart {
    width: 100%;
    border-collapse: collapse;
    border: 3px solid var(--ink);
    background: #ffffff;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }

  .pool-chart th,
  .pool-chart td {
    padding: 0.5rem;
    border-top: 1px solid var(--joint);
    text-align: right;
    vertical-align: top;
  }

  .pool-chart th[scope='row'],
  .pool-chart thead th:first-child {
    text-align: left;
  }

  .pool-chart thead th {
    border-top: 0;
    border-bottom: 3px solid var(--ink);
    font-weight: 600;
  }

  /* each link stands at least 24 px tall (WCAG 2.5.8, target size) */
  .pool-chart a {
    display: inline-block;
    min-height: 1.5rem;
  }

  .pool-unit {
    font-weight: 400;
    white-space: nowrap;
  }

  .pool-list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.5;
  }

  .pool-level-source {
    font-size: 0.875rem;
  }

  .pool-cite {
    padding: 1rem;
    border: 3px solid var(--ink);
    background: #ffffff;
    overflow-wrap: anywhere;
  }
</style>
