---
import type { Choice, FormView } from './model.ts';

interface Props {
  form: FormView;
}
const { form } = Astro.props;
const { unitsLabel, units, shapeLabel, shapes, fields, waste, bagLabel, bags, prices, copyLabel } =
  form;
const pressed = (choice: Choice): 'true' | 'false' => (choice.pressed ? 'true' : 'false');
---

<form class="calc-form" autocomplete="off" novalidate>
  <div class="calc-group" role="group" aria-labelledby="calc-units-label">
    <span class="calc-legend" id="calc-units-label">
      {unitsLabel}
    </span>
    {units.map((choice) => (
      <button
        class="calc-choice"
        type="button"
        data-unit={choice.id}
        aria-pressed={pressed(choice)}
        disabled
      >
        {choice.label}
      </button>
    ))}
  </div>
  <div class="calc-group" role="group" aria-labelledby="calc-shape-label">
    <span class="calc-legend" id="calc-shape-label">
      {shapeLabel}
    </span>
    {shapes.map((choice) => (
      <button
        class="calc-choice"
        type="button"
        data-shape-button={choice.id}
        aria-pressed={pressed(choice)}
        disabled
      >
        {choice.label}
      </button>
    ))}
  </div>
  <div class="calc-shape-area" data-reserved="shape">
    {fields.map((field) => (
      <div class="calc-field" data-shapes={field.shapes.join(' ')} hidden={!field.visible}>
        <label for={`calc-${field.key}`}>{field.label}</label>
        <input
          id={`calc-${field.key}`}
          name={field.key}
          inputmode={field.mode}
          autocomplete="off"
          value={field.value}
          disabled
        />
      </div>
    ))}
  </div>
  <div class="calc-field">
    <label for="calc-waste">{waste.label}</label>
    <input
      id="calc-waste"
      name={waste.key}
      inputmode={waste.mode}
      autocomplete="off"
      value={waste.value}
      disabled
    />
    <p class="calc-help">{waste.help}</p>
  </div>
  <div class="calc-steppers" data-reserved="steppers">
    <button class="calc-choice" type="button" data-waste-step="less" hidden disabled>
      {waste.less}
    </button>
    <button class="calc-choice" type="button" data-waste-step="more" hidden disabled>
      {waste.more}
    </button>
  </div>
  <div class="calc-group" role="group" aria-labelledby="calc-bag-label">
    <span class="calc-legend" id="calc-bag-label">
      {bagLabel}
    </span>
    {bags.map((choice) => (
      <button
        class="calc-choice"
        type="button"
        data-bag={choice.id}
        aria-pressed={pressed(choice)}
        disabled
      >
        {choice.label}
      </button>
    ))}
  </div>
  {prices.map((field) => (
    <div class="calc-field">
      <label for={`calc-${field.key}`}>{field.label}</label>
      <input
        id={`calc-${field.key}`}
        name={field.key}
        inputmode={field.mode}
        autocomplete="off"
        value={field.value}
        placeholder={field.placeholder}
        disabled
      />
    </div>
  ))}
  <div class="calc-copy" data-reserved="copy">
    <button class="calc-choice" type="button" data-copy hidden disabled>
      {copyLabel}
    </button>
    <p class="calc-status" data-copy-status role="status"></p>
  </div>
</form>
