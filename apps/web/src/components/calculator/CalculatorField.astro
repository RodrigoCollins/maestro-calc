---
import type { Field } from './model.ts';

interface Props {
  field: Field;
  /** The shapes a dimension input belongs to, joined into `data-shapes`; absent for the others. */
  shapes?: readonly string[];
  hidden?: boolean;
}
const { field, shapes, hidden = false } = Astro.props;
const id = `calc-${field.key}`;
const { hint, help } = field;
// The input is described by its unit hint and its help text; a message for an error uses the same
// attribute, so the script swaps it in (calculator-page › Errors without a button).
const describedBy = [hint === undefined ? '' : `${id}-hint`, help === undefined ? '' : `${id}-help`]
  .filter((part) => part !== '')
  .join(' ');
---

<div class="calc-field" data-shapes={shapes?.join(' ')} hidden={hidden}>
  <label for={id}>{field.label}</label>
  <input
    id={id}
    name={field.key}
    inputmode={field.mode}
    autocomplete="off"
    value={field.value}
    placeholder={field.placeholder}
    aria-describedby={describedBy === '' ? undefined : describedBy}
    disabled
  />
  {hint !== undefined && <small id={`${id}-hint`}>{hint}</small>}
  {help !== undefined && (
    <p class="calc-help" id={`${id}-help`}>
      {help}
    </p>
  )}
</div>
