# Cloudflare Workers static assets headers (served by `wrangler dev` too, never as a file).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Hashed fonts and CSS never change under one name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
