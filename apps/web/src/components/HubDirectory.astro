---
/** The directory of a trade hub (hubs): one card per calculator, then the guides of the trade. */
interface Props {
  calculatorsLabel: string;
  guidesLabel: string;
  calculators: readonly { href: string; title: string; summary: string }[];
  guides: readonly { href: string; title: string; summary: string }[];
  /** The job pages of the trade's calculators (growth plan, lever 1). */
  jobsLabel: string;
  jobs: readonly { href: string; title: string }[];
}
const { calculatorsLabel, guidesLabel, calculators, guides, jobsLabel, jobs } = Astro.props;
---

<section class="hub-directory" aria-label={calculatorsLabel}>
  <h2>{calculatorsLabel}</h2>
  <ul class="hub-cards" role="list">
    {calculators.map(({ href, title, summary }) => (
      <li class="hub-card">
        <a class="tap-target" {href}>
          {title}
        </a>
        <p>{summary}</p>
      </li>
    ))}
  </ul>
  {guides.length > 0 && (
    <>
      <h2>{guidesLabel}</h2>
      <ul class="hub-cards" role="list">
        {guides.map(({ href, title, summary }) => (
          <li class="hub-card hub-card-guide">
            <a class="tap-target" {href}>
              {title}
            </a>
            <p>{summary}</p>
          </li>
        ))}
      </ul>
    </>
  )}
  {jobs.length > 0 && (
    <>
      <h2>{jobsLabel}</h2>
      <ul>
        {jobs.map(({ href, title }) => (
          <li>
            <a {href}>{title}</a>
          </li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .hub-cards {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .hub-card {
    padding: var(--space-3);
    border: 2px solid var(--color-text);
    border-radius: 4px;
    background: var(--color-surface);
  }

  /* A guide card reads as an article: an orange edge instead of the full ink frame. */
  .hub-card-guide {
    border: 0;
    border-left: 6px solid var(--color-accent);
  }

  @media (min-width: 48rem) {
    .hub-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .hub-card a {
    font-weight: 600;
  }

  .hub-card p {
    margin: var(--space-1) 0 0;
  }
</style>
