{
  "name": "maestro-calc",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @maestro-calc/web",
    "build": "npm run build -w @maestro-calc/web",
    "preview": "npm run preview -w @maestro-calc/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~6.0.0",
    "vitest": "5.0.5"
  }
}
