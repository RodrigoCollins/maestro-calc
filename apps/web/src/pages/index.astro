---
import { ft2, toDecimalParts, valueIn } from '@maestro-calc/core';
import { rectangleArea } from '@maestro-calc/core/calculators/rectangle-area';
import { createTranslator } from '@maestro-calc/i18n';
import { enCommon } from '@maestro-calc/i18n/catalogs/en/common';
import { enRectangleArea } from '@maestro-calc/i18n/catalogs/en/rectangle-area';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteText } from '../lib/site-text.ts';
import { headFor } from '../seo/head.ts';

// Smoke wiring (not a product page): the default area of rectangle-area, through the package entry
// points, prerendered at build time. The page names its calculator by import, so a second entry in
// the registry (`lib/calculators.ts`, which the contract tests iterate) never changes this page.
const t = createTranslator({ ...enCommon, ...enRectangleArea });
const result = rectangleArea.run({});
const primary = result.ok
  ? result.value.outputs.find((output) => output.role === 'primary')
  : undefined;
if (primary === undefined) throw new Error('rectangle-area must run with its defaults');
const { integer, fraction } = toDecimalParts(valueIn(primary.value, ft2), 2);
const head = headFor('home', 'en', siteText('en'));
---

<BaseLayout locale="en" head={head}>
  <h1>{t('calc.rectangle-area.title')}</h1>
  <p>
    {t('calc.rectangle-area.outputs.areaFt2')}: {integer.toString()}.{fraction}
  </p>
</BaseLayout>
